---
import { type Lang } from "../i18n/ui";

interface Props { lang: Lang; }
const { lang } = Astro.props as Props;

const t = lang === "en" ? {
  body: "adolf.bg uses essential cookies only — an authentication cookie when you sign in, and a Stripe redirect cookie during checkout. No analytics, no marketing, no third-party tracking.",
  ok: "Got it",
  more: "Privacy",
  morePath: "/en/legal/privacy/",
} : {
  body: "adolf.bg използва само строго необходими cookies — auth cookie при вход и Stripe cookie при плащане. Без аналитика, без маркетинг, без трети страни.",
  ok: "Разбрах",
  more: "Поверителност",
  morePath: "/bg/legal/privacy/",
};
---
<aside id="adolf-cookie-banner" class="adolf-cookie-banner" role="region" aria-label="Cookie notice" hidden>
  <div class="adolf-cookie-text">{t.body}</div>
  <div class="adolf-cookie-actions">
    <a class="adolf-cookie-link" href={t.morePath}>{t.more}</a>
    <button class="adolf-cookie-btn" type="button" id="adolf-cookie-ok">{t.ok}</button>
  </div>
</aside>

<script is:inline>
  (function () {
    var KEY = "adolf-cookie-ack";
    function show() {
      var el = document.getElementById("adolf-cookie-banner");
      if (!el) return;
      try {
        if (document.cookie.split("; ").some(function (c) { return c.indexOf(KEY + "=") === 0; })) {
          return; // already acknowledged
        }
      } catch (_) { /* document.cookie can throw in some contexts; show banner */ }
      el.hidden = false;
    }
    function ack() {
      var d = new Date(); d.setFullYear(d.getFullYear() + 1);
      // Use the apex domain only when actually on adolf.bg — otherwise
      // (workers.dev, localhost) the browser rejects the domain attribute
      // and the cookie is never stored, so the banner reappears on reload.
      var host = location.hostname;
      var useApex = host === "adolf.bg" || host.indexOf(".adolf.bg") === host.length - 9;
      var domainAttr = useApex ? "; domain=.adolf.bg" : "";
      try {
        document.cookie = KEY + "=1; path=/" + domainAttr + "; expires=" + d.toUTCString() + "; SameSite=Lax";
      } catch (_) { /* localhost / no-domain dev → ignore */ }
      var el = document.getElementById("adolf-cookie-banner");
      if (el) el.hidden = true;
    }
    function wire() {
      var btn = document.getElementById("adolf-cookie-ok");
      if (btn) btn.addEventListener("click", ack);
      show();
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wire);
    } else {
      wire();
    }
  })();
</script>

<style>
  .adolf-cookie-banner {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 640px;
    margin: 0 auto;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    box-shadow: 0 6px 28px rgba(0,0,0,0.12);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.75rem;
    z-index: 1500;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink);
  }
  /* The HTML `hidden` attribute is supposed to hide the element via
   * `display: none`, but the `display: grid` above wins specificity-wise.
   * Re-assert `display: none` for the hidden state so the JS toggle
   * actually hides the banner. */
  .adolf-cookie-banner[hidden] {
    display: none !important;
  }
  @media (max-width: 540px) {
    .adolf-cookie-banner {
      grid-template-columns: 1fr;
    }
  }
  .adolf-cookie-text {
    color: var(--ink-soft);
  }
  .adolf-cookie-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: end;
  }
  @media (max-width: 540px) {
    .adolf-cookie-actions { justify-self: stretch; justify-content: flex-end; }
  }
  .adolf-cookie-link {
    font-size: 0.8rem;
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .adolf-cookie-btn {
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    border: 0;
    background: var(--ink);
    color: var(--bg);
    cursor: pointer;
  }
</style>
