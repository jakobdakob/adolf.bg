---
import { type Lang, ui } from "../i18n/ui";
import LangToggle from "./LangToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { url } from "../lib/topics";

interface Props {
  lang: Lang;
  otherPath: string;
  currentSection?: "ortho" | "trauma" | "anatomy" | "preface" | "qbank" | "home";
  showMenuButton?: boolean;
}
const { lang, otherPath, currentSection = "home", showMenuButton = false } = Astro.props;
const t = ui[lang];

const links = [
  { href: url(`/${lang}/ortho/1/`), label: t.sectionOrtho, key: "ortho" },
  { href: url(`/${lang}/trauma/1/`), label: t.sectionTrauma, key: "trauma" },
  { href: url(`/${lang}/anatomy/1/`), label: t.sectionAnatomy, key: "anatomy" },
  { href: url(`/${lang}/qbank/`),    label: t.sectionQBank,   key: "qbank" },
];
---
<header class="site-header">
  <div class="site-header-inner">
    {showMenuButton && (
      <button
        id="open-drawer"
        class="icon-btn"
        aria-label={t.openMenu}
        type="button"
        style="display:inline-flex;"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    )}
    <a href={url(`/${lang}/`)} class="brand">
      <span class="brand-name">adolf<span class="accent-dot">.</span>bg</span>
      <span class="brand-sub">{lang === "bg" ? "Държавен изпит" : "State board"}</span>
    </a>
    <nav class="nav-links" aria-label={t.contents}>
      {links.map((l) => (
        <a href={l.href} class:list={[l.key === currentSection && "is-current"]}>{l.label}</a>
      ))}
    </nav>
    <div style="flex:1"></div>
    <button id="open-search" class="search-trigger" type="button" aria-label={t.search} title={`${t.search} (⌘K)`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span class="search-trigger-kbd" aria-hidden="true">⌘K</span>
    </button>
    <ThemeToggle lang={lang} />
    <LangToggle lang={lang} otherPath={otherPath} />
  </div>
</header>

<style>
  @media (max-width: 879px) {
    .nav-links { display: none; }
  }
  #open-drawer { display: none; }
  @media (max-width: 1023px) {
    #open-drawer[style*="inline-flex"] { display: inline-flex; }
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: transparent;
    color: var(--ink-muted);
    font-family: inherit;
    cursor: pointer;
    transition: border-color 160ms var(--ease), color 160ms var(--ease);
  }
  .search-trigger:hover { color: var(--ink); border-color: var(--ink-muted); }
  .search-trigger-kbd {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint, var(--ink-muted));
    padding: 0 0.15rem;
  }
  @media (max-width: 540px) {
    .search-trigger-kbd { display: none; }
    .search-trigger { padding: 0.35rem 0.4rem; }
  }
</style>

<script is:inline>
  (function () {
    var b = document.getElementById("open-search");
    if (b) b.addEventListener("click", function () { if (window.__openSearch) window.__openSearch(); });
  })();
</script>
