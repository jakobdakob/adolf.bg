---
import { type Lang, ui } from "../i18n/ui";
import LangToggle from "./LangToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { url } from "../lib/topics";

interface Props {
  lang: Lang;
  otherPath: string;
  currentSection?: "ortho" | "trauma" | "anatomy" | "preface" | "home";
  showMenuButton?: boolean;
}
const { lang, otherPath, currentSection = "home", showMenuButton = false } = Astro.props;
const t = ui[lang];

const links = [
  { href: url(`/${lang}/ortho/1/`), label: t.sectionOrtho, key: "ortho" },
  { href: url(`/${lang}/trauma/1/`), label: t.sectionTrauma, key: "trauma" },
  { href: url(`/${lang}/anatomy/1/`), label: t.sectionAnatomy, key: "anatomy" },
];
---
<header class="site-header">
  <div class="site-header-inner">
    {showMenuButton && (
      <button
        id="open-drawer"
        class="icon-btn"
        aria-label={t.openMenu}
        type="button"
        style="display:inline-flex;"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    )}
    <a href={url(`/${lang}/`)} class="brand">
      <span class="brand-name">adolf<span class="accent-dot">.</span>bg</span>
      <span class="brand-sub">{lang === "bg" ? "Държавен изпит" : "State board"}</span>
    </a>
    <nav class="nav-links" aria-label={t.contents}>
      {links.map((l) => (
        <a href={l.href} class:list={[l.key === currentSection && "is-current"]}>{l.label}</a>
      ))}
    </nav>
    <div style="flex:1"></div>
    <ThemeToggle lang={lang} />
    <LangToggle lang={lang} otherPath={otherPath} />
  </div>
</header>

<style>
  @media (max-width: 879px) {
    .nav-links { display: none; }
  }
  #open-drawer { display: none; }
  @media (max-width: 1023px) {
    #open-drawer[style*="inline-flex"] { display: inline-flex; }
  }
</style>
