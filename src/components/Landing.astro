---
import { type Lang, ui } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTopicsByLang, groupTopics, topicPath, otherLangPath } from "../lib/topics";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const all = await getTopicsByLang(lang);
const { ortho, trauma, anatomy } = groupTopics(all);
const otherPath = otherLangPath(lang);

const heroEyebrow = lang === "bg"
  ? "Ортопедия и травматология · Държавен изпит"
  : "Orthopedics & Traumatology · State Board";

const heroTitle = lang === "bg" ? "Компендиум." : "Compendium.";

const heroSubtitle = lang === "bg"
  ? "Свързан учебен текст по 74 теми, обхващащ ортопедията, травматологията и хирургичната анатомия — синтезиран от 14 справочни издания за подготовка за държавния изпит."
  : "A connected exam-prep text across 74 topics covering orthopedics, traumatology, and surgical anatomy — synthesised from 14 reference textbooks for the Bulgarian state board.";

const ctaOrtho    = lang === "bg" ? "Към Ортопедия"    : "Jump to Orthopedics";
const ctaTrauma   = lang === "bg" ? "Към Травматология" : "Jump to Traumatology";
const ctaAnatomy  = lang === "bg" ? "Към Анатомия"      : "Jump to Anatomy";
const ctaFeedback = lang === "bg" ? "Обратна връзка?"   : "Feedback?";

const viberChat = "viber://chat?number=%2B41768150804";

const contentsLabel = lang === "bg" ? "Съдържание" : "Contents";
const contentsTitle = lang === "bg" ? "Темите." : "The topics.";
const contentsLede = lang === "bg"
  ? "Тридесет теми по ортопедия, тридесет и две по травматология, дванадесет по хирургична анатомия. Кликни произволна, за да започнеш."
  : "Thirty topics in orthopedics, thirty-two in traumatology, twelve in surgical anatomy. Click any to begin.";
---
<BaseLayout lang={lang} otherPath={otherPath}>
  <section class="hero">
    <div class="hero-inner reveal">
      <span class="eyebrow">{heroEyebrow}</span>
      <h1 class="hero-display">{heroTitle}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <div class="cta-stack">
        <a href="#ortho"   class="btn btn-primary btn-block">{ctaOrtho}</a>
        <a href="#trauma"  class="btn btn-primary btn-block">{ctaTrauma}</a>
        <a href="#anatomy" class="btn btn-primary btn-block">{ctaAnatomy}</a>
        <a href={viberChat} class="btn btn-viber btn-block" rel="external">{ctaFeedback}</a>
      </div>
    </div>
  </section>

  <section id="contents" class="toc">
    <div class="toc-head reveal">
      <span class="eyebrow">{contentsLabel}</span>
      <h2 class="section-title">{contentsTitle}</h2>
      <p class="section-lede">{contentsLede}</p>
    </div>

    {([
      { id: "ortho",   label: t.sectionOrtho,   topics: ortho },
      { id: "trauma",  label: t.sectionTrauma,  topics: trauma },
      { id: "anatomy", label: t.sectionAnatomy, topics: anatomy },
    ] as const).map((group) => {
      const half = Math.ceil(group.topics.length / 2);
      const left = group.topics.slice(0, half);
      const right = group.topics.slice(half);
      return (
        <div id={group.id} class="toc-group reveal">
          <div class="toc-group-label">{group.label}</div>
          <div class="toc-cols">
            {[left, right].map((col, i) => (
              <ol class="toc-list" start={i === 0 ? 1 : half + 1}>
                {col.map((e) => (
                  <li>
                    <a href={topicPath(lang, e)}>
                      <span class="toc-num">{String(e.data.topicNumber).padStart(2, "0")}</span>
                      <span class="toc-title">{e.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            ))}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: clamp(var(--s-8), 10vw, var(--s-10));
    padding-bottom: var(--s-9);
  }
  .hero-inner { max-width: 1000px; }

  #ortho, #trauma, #anatomy { scroll-margin-top: 72px; }

  .toc {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: var(--s-9);
    padding-bottom: var(--s-10);
  }
  .toc-head { margin-bottom: var(--s-8); max-width: 720px; }
  .toc-group { margin-bottom: var(--s-8); }
  .toc-group-label {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s-4);
  }
  .toc-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 760px) {
    .toc-cols {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s-7);
    }
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .toc-list li {
    border-bottom: 1px solid var(--rule);
  }
  .toc-list a {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: var(--s-3);
    padding: 0.95rem 0;
    color: var(--ink);
    transition: color 160ms var(--ease), transform 220ms var(--ease);
  }
  .toc-list a:hover {
    color: var(--accent);
    transform: translateX(var(--s-2));
  }
  .toc-num {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-meta);
    color: var(--ink-faint);
    padding-top: 0.1rem;
  }
  .toc-list a:hover .toc-num { color: var(--accent); }
  .toc-title { font-size: 1rem; line-height: 1.5; }
</style>
