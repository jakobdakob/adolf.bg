---
import { type Lang, ui } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTopicsByLang, groupTopics, topicPath, otherLangPath } from "../lib/topics";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const all = await getTopicsByLang(lang);
const { ortho, trauma, anatomy } = groupTopics(all);
const otherPath = otherLangPath(lang);

const heroEyebrow = lang === "bg"
  ? "Ортопедия и травматология · Държавен изпит"
  : "Orthopedics & Traumatology · State Board";

const heroTitle = lang === "bg" ? "Компендиум." : "Compendium.";

const heroSubtitle = lang === "bg"
  ? "Свързан учебен текст по 74 теми, обхващащ ортопедията, травматологията и хирургичната анатомия — синтезиран от 14 справочни издания за подготовка за държавния изпит."
  : "A connected exam-prep text across 74 topics covering orthopedics, traumatology, and surgical anatomy — synthesised from 14 reference textbooks for the Bulgarian state board.";

const ctaFeedback = lang === "bg" ? "Обратна връзка?"   : "Feedback?";

const viberChat = "viber://chat?number=%2B41768150804";
---
<BaseLayout lang={lang} otherPath={otherPath}>
  <section class="hero">
    <div class="hero-inner reveal">
      <span class="eyebrow">{heroEyebrow}</span>
      <h1 class="hero-display">{heroTitle}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <div class="hero-feedback">
        <a href={viberChat} class="btn btn-viber" rel="external">{ctaFeedback}</a>
      </div>
    </div>
  </section>

  <section id="contents" class="toc">
    {([
      { id: "ortho",   label: t.sectionOrtho,   topics: ortho },
      { id: "trauma",  label: t.sectionTrauma,  topics: trauma },
      { id: "anatomy", label: t.sectionAnatomy, topics: anatomy },
    ] as const).map((group) => {
      const half = Math.ceil(group.topics.length / 2);
      const left = group.topics.slice(0, half);
      const right = group.topics.slice(half);
      return (
        <div id={group.id} class="toc-group reveal">
          <div class="toc-group-label">{group.label}</div>
          <div class="toc-cols">
            {[left, right].map((col, i) => (
              <ol class="toc-list" start={i === 0 ? 1 : half + 1}>
                {col.map((e) => (
                  <li>
                    <a href={topicPath(lang, e)}>
                      <span class="toc-num">{String(e.data.topicNumber).padStart(2, "0")}</span>
                      <span class="toc-title">{e.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            ))}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: clamp(var(--s-8), 10vw, var(--s-10));
    padding-bottom: var(--s-9);
  }
  .hero-inner { max-width: 1100px; }

  .hero-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    margin-top: var(--s-7);
  }
  @media (min-width: 720px) {
    .hero-cards { grid-template-columns: repeat(3, 1fr); }
  }
  .hero-card {
    display: block;
    padding: var(--s-5) var(--s-5);
    border: 1px solid var(--rule);
    border-radius: 14px;
    color: var(--ink);
    background: transparent;
    transition: border-color 200ms var(--ease), transform 220ms var(--ease), background-color 200ms var(--ease);
  }
  .hero-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .hero-card-num {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-meta, 0.875rem);
    color: var(--ink-faint, var(--ink-muted));
    margin-bottom: var(--s-3);
    letter-spacing: 0.02em;
  }
  .hero-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-bottom: var(--s-2);
    color: var(--accent);
  }
  .hero-card-meta {
    font-size: var(--fs-meta, 0.875rem);
    color: var(--ink-muted);
  }
  .hero-feedback {
    margin-top: var(--s-6);
    display: flex;
    justify-content: flex-start;
  }

  #ortho, #trauma, #anatomy { scroll-margin-top: 72px; }

  .toc {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: var(--s-6);
    padding-bottom: var(--s-7);
  }
  .toc-group { margin-bottom: var(--s-6); }
  .toc-group:last-child { margin-bottom: 0; }
  .toc-group-label {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s-4);
  }
  .toc-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 760px) {
    .toc-cols {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s-7);
    }
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .toc-list li {
    border-bottom: 1px solid var(--rule);
  }
  /* When the two columns stack on mobile, suppress the second list's
   * border-top so it doesn't double-up with the previous list's last
   * row border-bottom (visible as a thicker divider). Also drop the
   * very last row's border so the list flows cleanly into the footer. */
  @media (max-width: 759px) {
    .toc-cols > .toc-list + .toc-list { border-top: 0; }
    .toc-group:last-child .toc-list:last-child > li:last-child {
      border-bottom: 0;
    }
    .toc { padding-bottom: 0; }
  }
  .toc-list a {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: var(--s-3);
    padding: 0.95rem 0;
    color: var(--ink);
    transition: color 160ms var(--ease), transform 220ms var(--ease);
  }
  .toc-list a:hover {
    color: var(--accent);
    transform: translateX(var(--s-2));
  }
  .toc-num {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-meta);
    color: var(--ink-faint);
    padding-top: 0.1rem;
  }
  .toc-list a:hover .toc-num { color: var(--accent); }
  .toc-title { font-size: 1rem; line-height: 1.5; }
</style>
