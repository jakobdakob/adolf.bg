---
import { type Lang, ui, otherLang } from "../i18n/ui";

interface Props {
  lang: Lang;
  otherPath: string;
}
const { lang, otherPath } = Astro.props;
const other = otherLang(lang);
const t = ui[lang];
---
<a
  href={otherPath}
  class="lang-toggle"
  aria-label={`${t.switchTo[other]} — ${other.toUpperCase()}`}
  title={t.switchTo[other]}
>
  <span class:list={["seg", lang === "bg" && "is-active"]}>BG</span>
  <span class:list={["seg", lang === "en" && "is-active"]}>EN</span>
</a>
