---
import { type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = lang === "bg"
  ? {
      heading: "Пълен достъп до всичките 74 теми",
      sub: "Магически линк за вход • без парола",
      tiers: [
        { name: "3 месеца", price: "49,99 €", permo: "≈ 16,66 €/мес", badge: "", plan: "3m" },
        { name: "6 месеца", price: "79,99 €", permo: "≈ 13,33 €/мес", badge: "★ Най-популярен", plan: "6m" },
        { name: "12 месеца", price: "99,99 €", permo: "≈ 8,33 €/мес", badge: "★ Най-добра цена", plan: "12m" },
      ],
      choose: "Избери",
      already: "Вече имаш достъп?",
      enterEmail: "Въведи имейл",
    }
  : {
      heading: "Full access to all 74 topics",
      sub: "Magic-link sign-in • no password",
      tiers: [
        { name: "3 months", price: "€49.99", permo: "≈ €16.66/mo", badge: "", plan: "3m" },
        { name: "6 months", price: "€79.99", permo: "≈ €13.33/mo", badge: "★ Most popular", plan: "6m" },
        { name: "12 months", price: "€99.99", permo: "≈ €8.33/mo", badge: "★ Best value", plan: "12m" },
      ],
      choose: "Choose",
      already: "Already paid?",
      enterEmail: "Enter your email",
    };
---
<aside class="paywall-card" data-paywall-card hidden aria-label={copy.heading}>
  <h2 class="paywall-heading">{copy.heading}</h2>
  <p class="paywall-heading-sub">{copy.sub}</p>
  <div class="paywall-tiers">
    {copy.tiers.map((t) => (
      <button type="button" class="paywall-tier" data-paywall-plan={t.plan}>
        <div class="paywall-tier-meta">
          <span class="paywall-tier-name">{t.name}</span>
          <span class="paywall-tier-price">{t.price}</span>
          <span class="paywall-tier-permo">{t.permo}</span>
          {t.badge && <span class="paywall-tier-badge">{t.badge}</span>}
        </div>
        <span class="paywall-tier-cta">
          {copy.choose}
          <span aria-hidden="true">→</span>
        </span>
      </button>
    ))}
  </div>
  <div class="paywall-already">
    <span>{copy.already}</span>
    <button type="button" class="paywall-already-link" data-paywall-email>
      {copy.enterEmail}
      <span aria-hidden="true"> →</span>
    </button>
  </div>
</aside>
