---
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** URL of the curated game-data JSON (built by `npm run build:game-data`). */
  src: string;
  /** URL of the qbank index, used for the "back to Q-bank" link. */
  back: string;
}
const { lang, src, back } = Astro.props;

/* ------------------------------------------------------------------ */
/* Localised copy — every visible string in both languages.            */
/* ------------------------------------------------------------------ */
const t = lang === "bg"
  ? {
      title:      "БОЙЧЕВ КОМБАТ",
      subtitle:   "Изпит при професора",
      pushStart:  "НАТИСНИ START",
      menuPlay:   "ИГРАЙ",
      menuLeaderboard: "КЛАСИРАНЕ",
      menuHelp:   "КАК СЕ ИГРАЕ",
      menuBack:   "Q-BANK",
      helpTitle:  "КАК СЕ ИГРАЕ",
      help: [
        "Изпитът започва. W/A/S/D или 1/2/3/4 — избираш отговор.",
        "Верен — удряш противника. Грешен — губиш живот.",
        "5-и и 10-и кръг са МИНИ-БОСОВЕ: +HP, грешка = -2 живота.",
        "Победи 10 патогена и ще се изправиш срещу ПРОФ. БОЙЧЕВ.",
        "5 верни поред = 1.5×, 10 = 2×, 15 = 3× точки.",
        "0 живота → КРАЙ НА ИГРАТА.",
      ],
      backToMenu: "← НАЗАД",
      gameOver:   "КРАЙ НА ИГРАТА",
      fight:      "БОЙ!",
      victory:    "ПОБЕДА!",
      flawless:   "БЕЗУПРЕЧНА ПОБЕДА!",
      finishHim:  "ДОВЪРШИ ГО!",
      continueP:  "ПРОДЪЛЖИ?",
      newHighscore: "НОВ РЕКОРД!",
      enterName:  "ВЪВЕДИ ИМЕТО",
      save:       "ЗАПАЗИ",
      yourScore:  "ТОЧКИ",
      yourEnemies: "ПОБЕДЕНИ",
      noLeaderboard: "ВСЕ ОЩЕ НЯМА РЕЗУЛТАТИ.",
      lives:      "ЖИВОТИ",
      score:      "ТОЧКИ",
      round:      "КРЪГ",
      hero:       "СПЕЦИАЛИЗАНТ",
      bossPrefix: "ПРОФ. ",
      ouch:       "ОЙ!",
      extraLife:  "+ЖИВОТ",
      vs:         "СРЕЩУ",
      streak:     "СЕРИЯ",
      multiplier: "×",
      bossIncoming: "МИНИ-БОС!",
      finalIncoming: "ФИНАЛЕН БОС!",
      doubleDamage: "-2 ЖИВОТА",
      worstTopics: "НАЙ-СЛАБИ ТЕМИ",
      wrongOf:    "грешни от",
      restart:    "НОВ БОЙ",
      finalVictory: "ИЗДЪРЖА ИЗПИТА!",
      bestStreak: "НАЙ-ДЪЛГА СЕРИЯ",
    }
  : {
      title:      "BOYCHEV KOMBAT",
      subtitle:   "The professor's exam",
      pushStart:  "PUSH START",
      menuPlay:   "START",
      menuLeaderboard: "LEADERBOARD",
      menuHelp:   "HOW TO PLAY",
      menuBack:   "Q-BANK",
      helpTitle:  "HOW TO PLAY",
      help: [
        "Exam in session. Press W/A/S/D or 1/2/3/4 to answer.",
        "Right answer hits your opponent. Wrong — you lose a life.",
        "Rounds 5 & 10 are MINI-BOSSES: more HP, wrong = -2 lives.",
        "Defeat 10 pathogens, then face PROF. BOYCHEV — the final boss.",
        "5 in a row = 1.5×, 10 = 2×, 15 = 3× score.",
        "0 lives → GAME OVER.",
      ],
      backToMenu: "← BACK",
      gameOver:   "GAME OVER",
      fight:      "FIGHT!",
      victory:    "VICTORY!",
      flawless:   "FLAWLESS VICTORY!",
      finishHim:  "FINISH HIM!",
      continueP:  "CONTINUE?",
      newHighscore: "NEW HIGHSCORE!",
      enterName:  "ENTER YOUR NAME",
      save:       "SAVE",
      yourScore:  "SCORE",
      yourEnemies: "DEFEATED",
      noLeaderboard: "NO SCORES YET.",
      lives:      "LIVES",
      score:      "SCORE",
      round:      "ROUND",
      hero:       "RESIDENT",
      bossPrefix: "PROF. ",
      ouch:       "OUCH",
      extraLife:  "+LIFE",
      vs:         "VS",
      streak:     "STREAK",
      multiplier: "×",
      bossIncoming: "MINI-BOSS!",
      finalIncoming: "FINAL BOSS!",
      doubleDamage: "-2 LIVES",
      worstTopics: "WEAKEST TOPICS",
      wrongOf:    "wrong of",
      restart:    "FIGHT AGAIN",
      finalVictory: "EXAM PASSED!",
      bestStreak: "LONGEST STREAK",
    };

/* ------------------------------------------------------------------ */
/* Wave roster — 10 germs in fixed order + Prof. Boychev (final).      */
/*                                                                    */
/*  hp          how many right answers to defeat                       */
/*  topicPat    regex source (case-insensitive) matched against BG+EN  */
/*              topic titles; questions from matching topics form this  */
/*              enemy's draw pool. <40 matches falls back to full pool. */
/*  boss        mini-boss: wrong answer costs 2 lives                   */
/*  final       Prof. Boychev — same -2 penalty, much higher HP         */
/* ------------------------------------------------------------------ */
const enemies = [
  { name: "STAPH AUREUS",    hp: 4,  color: "#39ff14", icon: "🦠",
    topicPat: "(pyogen|septic|osteomyel|infect|инфекц|остеомиел|септ)" },
  { name: "STREP PYOGENES",  hp: 4,  color: "#39ff14", icon: "🟠",
    topicPat: "(pyogen|septic|wound|cellul|инфекц|септ|рана|гной)" },
  { name: "E. COLI",         hp: 4,  color: "#39ff14", icon: "🟢",
    topicPat: "(spine|spondyl|pelvi|sacr|спин|спондил|тазов|сакр|гръбнач)" },
  { name: "PSEUDOMONAS",     hp: 5,  color: "#39ff14", icon: "🦠",
    topicPat: "(osteomyel|arthroplast|prosth|complication|остеомиел|артропласт|ендопрот|усложнен)" },
  { name: "M. R. S. A.",     hp: 6,  color: "#ffe000", icon: "💀", boss: true,
    topicPat: "(pyogen|septic|osteomyel|infect|prosth|arthroplast|инфекц|остеомиел|септ|артропласт|ендопрот)" },
  { name: "KLEBSIELLA",      hp: 5,  color: "#39ff14", icon: "🦠",
    topicPat: "(infect|wound|polytrauma|инфекц|рана|политравм)" },
  { name: "ACINETOBACTER",   hp: 5,  color: "#39ff14", icon: "⚡",
    topicPat: "(gunshot|wound|polytraum|amput|crush|огнестрел|рана|политравм|ампут)" },
  { name: "ENTEROCOCCUS",    hp: 5,  color: "#39ff14", icon: "🦠",
    topicPat: "(arthroplast|prosth|coxarthros|gonarthros|артропласт|ендопрот|коксартроз|гонартроз)" },
  { name: "C. DIFFICILE",    hp: 5,  color: "#39ff14", icon: "💩",
    topicPat: "(complication|nonunion|delayed|sudeck|volkmann|усложнен|неконсолид|забавен)" },
  { name: "M. TUBERCULOSIS", hp: 6,  color: "#ffe000", icon: "☠️", boss: true,
    topicPat: "(tubercul|spondyliti|ankylosing|spine|туберкул|спондил|спин|гръбнач)" },
  // Round 11 — final boss. Pulls questions from anywhere in the pool.
  { name: "БОЙЧО БОЙЧЕВ",    hp: 12, color: "#e01010", icon: "🥼", final: true,
    topicPat: "" },
];

const enemiesJson = JSON.stringify(enemies);
const tJson = JSON.stringify(t);
---

<!-- Google Font: Press Start 2P. Harmless if already cached. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" />

<section
  class="kombat"
  data-kombat
  data-lang={lang}
  data-src={src}
  data-back={back}
  data-enemies={enemiesJson}
  data-t={tJson}
>
  <div class="kombat-cabinet">
    <div class="kombat-marquee" aria-hidden="true">
      <span class="kombat-marquee-dot" />
      <span class="kombat-marquee-text">BOYCHEV KOMBAT · 100% MED-CERTIFIED</span>
      <span class="kombat-marquee-dot" />
    </div>

    <div class="kombat-bezel">
      <div class="kombat-screen" data-kombat-screen-wrap>

        <div class="kombat-hud">
          <div class="kombat-hud-side kombat-hud-left">
            <div class="kombat-hud-label">{t.hero}</div>
            <div class="kombat-hp-bar"><div class="kombat-hp-fill kombat-hp-hero" data-kombat-hero-hp></div></div>
            <div class="kombat-lives" data-kombat-lives>
              <span class="kombat-life">♥</span>
              <span class="kombat-life">♥</span>
              <span class="kombat-life">♥</span>
            </div>
          </div>
          <div class="kombat-hud-center">
            <div class="kombat-hud-label">{t.score}</div>
            <div class="kombat-hud-score" data-kombat-score>0000</div>
            <div class="kombat-hud-meta">
              <span>{t.round}</span>
              <span data-kombat-round>1</span>
              <span class="kombat-hud-sep">/</span>
              <span>11</span>
            </div>
            <div class="kombat-hud-streak" data-kombat-streak hidden>
              <span data-kombat-streak-val>0</span> {t.streak}
              <span class="kombat-hud-mult" data-kombat-streak-mult></span>
            </div>
          </div>
          <div class="kombat-hud-side kombat-hud-right">
            <div class="kombat-hud-label" data-kombat-foe-name>STAPH AUREUS</div>
            <div class="kombat-hp-bar"><div class="kombat-hp-fill kombat-hp-foe" data-kombat-foe-hp></div></div>
            <div class="kombat-hud-vs">{t.vs}</div>
          </div>
        </div>

        <div class="kombat-arena">
          <div class="kombat-fighter kombat-fighter-hero" data-kombat-hero>
            <img class="kombat-portrait" src="/game/boychev.png" alt={t.hero} onerror="this.style.display='none'" />
            <div class="kombat-portrait-fallback kombat-portrait-fallback-hero">🧑‍⚕️</div>
            <div class="kombat-fighter-name">{t.hero}</div>
          </div>
          <div class="kombat-fighter kombat-fighter-foe" data-kombat-foe>
            <div class="kombat-foe-emoji" data-kombat-foe-icon>🦠</div>
            <div class="kombat-fighter-name" data-kombat-foe-label>STAPH AUREUS</div>
          </div>
        </div>

        <div class="kombat-crt" aria-hidden="true"></div>
        <div class="kombat-banner" data-kombat-banner hidden></div>
        <div class="kombat-fx" data-kombat-fx aria-hidden="true"></div>

        <div class="kombat-overlay kombat-menu" data-kombat-screen="menu">
          <div class="kombat-logo">{t.title}</div>
          <div class="kombat-logo-sub">{t.subtitle}</div>
          <div class="kombat-push" data-kombat-push>{t.pushStart}</div>
          <div class="kombat-menu-buttons">
            <button type="button" class="kombat-cab-btn kombat-cab-btn-primary" data-kombat-menu="play">{t.menuPlay} ▶</button>
            <button type="button" class="kombat-cab-btn" data-kombat-menu="leaderboard">{t.menuLeaderboard}</button>
            <button type="button" class="kombat-cab-btn" data-kombat-menu="help">{t.menuHelp}</button>
            <a class="kombat-cab-btn kombat-cab-btn-ghost" href={back}>← {t.menuBack}</a>
          </div>
        </div>

        <div class="kombat-overlay kombat-help" data-kombat-screen="help" hidden>
          <h2 class="kombat-overlay-title">{t.helpTitle}</h2>
          <div class="kombat-wasd-diagram" aria-hidden="true">
            <div class="kombat-wasd-key kombat-wasd-key-w">W</div>
            <div class="kombat-wasd-key kombat-wasd-key-a">A</div>
            <div class="kombat-wasd-key kombat-wasd-key-s">S</div>
            <div class="kombat-wasd-key kombat-wasd-key-d">D</div>
          </div>
          <ol class="kombat-help-list">
            {t.help.map((line) => <li>{line}</li>)}
          </ol>
          <button type="button" class="kombat-cab-btn" data-kombat-menu="menu">{t.backToMenu}</button>
        </div>

        <div class="kombat-overlay kombat-board" data-kombat-screen="leaderboard" hidden>
          <h2 class="kombat-overlay-title">{t.menuLeaderboard}</h2>
          <ol class="kombat-board-list" data-kombat-board-list>
            <li class="kombat-board-empty">{t.noLeaderboard}</li>
          </ol>
          <button type="button" class="kombat-cab-btn" data-kombat-menu="menu">{t.backToMenu}</button>
        </div>

        <div class="kombat-overlay kombat-gameover" data-kombat-screen="gameover" hidden>
          <div class="kombat-gameover-title" data-kombat-gameover-title>{t.gameOver}</div>
          <div class="kombat-gameover-stats">
            <div class="kombat-gameover-row"><span>{t.yourScore}</span><span class="kombat-gameover-val" data-kombat-final-score>0</span></div>
            <div class="kombat-gameover-row"><span>{t.yourEnemies}</span><span class="kombat-gameover-val" data-kombat-final-kills>0</span></div>
            <div class="kombat-gameover-row"><span>{t.bestStreak}</span><span class="kombat-gameover-val" data-kombat-final-streak>0</span></div>
          </div>
          <div class="kombat-gameover-highscore" data-kombat-newrec hidden>★ {t.newHighscore} ★</div>
          <div class="kombat-weakness" data-kombat-weakness hidden></div>
          <div class="kombat-gameover-name" data-kombat-name-row hidden>
            <label for="kombat-name">{t.enterName}</label>
            <input id="kombat-name" type="text" maxlength="14" autocomplete="off" />
            <button type="button" class="kombat-cab-btn kombat-cab-btn-primary" data-kombat-save>{t.save}</button>
          </div>
          <div class="kombat-gameover-actions">
            <button type="button" class="kombat-cab-btn kombat-cab-btn-primary" data-kombat-menu="play">{t.restart} ▶</button>
            <button type="button" class="kombat-cab-btn" data-kombat-menu="menu">{t.backToMenu}</button>
          </div>
        </div>

      </div>

      <div class="kombat-deck" data-kombat-deck>
        <div class="kombat-q" data-kombat-question hidden>
          <div class="kombat-q-meta" data-kombat-q-meta></div>
          <div class="kombat-q-stem" data-kombat-q-stem></div>
        </div>
        <div class="kombat-answers" data-kombat-options hidden>
          <button type="button" class="kombat-key" data-kombat-option="0">
            <span class="kombat-key-letter">W</span>
            <span class="kombat-key-num">1</span>
            <span class="kombat-key-text"></span>
          </button>
          <button type="button" class="kombat-key" data-kombat-option="1">
            <span class="kombat-key-letter">A</span>
            <span class="kombat-key-num">2</span>
            <span class="kombat-key-text"></span>
          </button>
          <button type="button" class="kombat-key" data-kombat-option="2">
            <span class="kombat-key-letter">S</span>
            <span class="kombat-key-num">3</span>
            <span class="kombat-key-text"></span>
          </button>
          <button type="button" class="kombat-key" data-kombat-option="3">
            <span class="kombat-key-letter">D</span>
            <span class="kombat-key-num">4</span>
            <span class="kombat-key-text"></span>
          </button>
        </div>
        <div class="kombat-deck-hint" data-kombat-deck-hint>
          {t.pushStart}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ tJson, enemiesJson }}>
(function () {
  const root = document.querySelector("[data-kombat]");
  if (!root) return;
  const lang = root.dataset.lang;
  const src = root.dataset.src;
  const T = JSON.parse(tJson);
  const ENEMIES = JSON.parse(enemiesJson);
  const FINAL_IDX = ENEMIES.length - 1;
  const STORAGE_KEY = "kombat-leaderboard-v1";

  const els = {
    screenWrap: root.querySelector("[data-kombat-screen-wrap]"),
    deck:       root.querySelector("[data-kombat-deck]"),
    deckHint:   root.querySelector("[data-kombat-deck-hint]"),
    score:      root.querySelector("[data-kombat-score]"),
    round:      root.querySelector("[data-kombat-round]"),
    streakHud:  root.querySelector("[data-kombat-streak]"),
    streakVal:  root.querySelector("[data-kombat-streak-val]"),
    streakMult: root.querySelector("[data-kombat-streak-mult]"),
    foeName:    root.querySelector("[data-kombat-foe-name]"),
    foeLabel:   root.querySelector("[data-kombat-foe-label]"),
    foeIcon:    root.querySelector("[data-kombat-foe-icon]"),
    foeHp:      root.querySelector("[data-kombat-foe-hp]"),
    heroHp:     root.querySelector("[data-kombat-hero-hp]"),
    lives:      root.querySelector("[data-kombat-lives]"),
    hero:       root.querySelector("[data-kombat-hero]"),
    foe:        root.querySelector("[data-kombat-foe]"),
    question:   root.querySelector("[data-kombat-question]"),
    qMeta:      root.querySelector("[data-kombat-q-meta]"),
    qStem:      root.querySelector("[data-kombat-q-stem]"),
    options:    root.querySelector("[data-kombat-options]"),
    optionBtns: root.querySelectorAll("[data-kombat-option]"),
    fx:         root.querySelector("[data-kombat-fx]"),
    banner:     root.querySelector("[data-kombat-banner]"),
    finalScore: root.querySelector("[data-kombat-final-score]"),
    finalKills: root.querySelector("[data-kombat-final-kills]"),
    finalStreak:root.querySelector("[data-kombat-final-streak]"),
    gameoverTitle: root.querySelector("[data-kombat-gameover-title]"),
    newRec:     root.querySelector("[data-kombat-newrec]"),
    weakness:   root.querySelector("[data-kombat-weakness]"),
    nameInput:  root.querySelector("#kombat-name"),
    nameRow:    root.querySelector("[data-kombat-name-row]"),
    saveBtn:    root.querySelector("[data-kombat-save]"),
    boardList:  root.querySelector("[data-kombat-board-list]"),
  };

  const overlays = root.querySelectorAll("[data-kombat-screen]");

  function showOverlay(name) {
    overlays.forEach((o) => {
      if (o.dataset.kombatScreen === name) o.removeAttribute("hidden");
      else o.setAttribute("hidden", "");
    });
  }
  function hideOverlay() { overlays.forEach((o) => o.setAttribute("hidden", "")); }

  function setDeck(visible) {
    if (els.question) els.question.toggleAttribute("hidden", !visible);
    if (els.options) els.options.toggleAttribute("hidden", !visible);
    if (els.deckHint) els.deckHint.toggleAttribute("hidden", visible);
  }

  let pool = null;
  let topicTitles = null;
  let enemyPools = null;

  async function loadPool() {
    if (pool) return pool;
    const res = await fetch(src, { cache: "force-cache" });
    if (!res.ok) throw new Error("Pool fetch failed: " + res.status);
    const data = await res.json();
    pool = data.questions || [];
    topicTitles = data.topicTitles || null;
    return pool;
  }

  function buildEnemyPools() {
    if (enemyPools || !pool || !pool.length) return;
    enemyPools = { "*": pool };
    for (const e of ENEMIES) {
      if (!e.topicPat) { enemyPools[e.name] = pool; continue; }
      let re;
      try { re = new RegExp(e.topicPat, "i"); }
      catch (err) { enemyPools[e.name] = pool; continue; }
      const matchedTopicKeys = new Set();
      if (topicTitles) {
        for (const sect of Object.keys(topicTitles)) {
          for (const n of Object.keys(topicTitles[sect])) {
            const tt = topicTitles[sect][n];
            if (re.test(tt.en || "") || re.test(tt.bg || "")) {
              matchedTopicKeys.add(sect + ":" + n);
            }
          }
        }
      }
      const sub = pool.filter((q) => matchedTopicKeys.has(q.section + ":" + q.topic));
      enemyPools[e.name] = sub.length >= 40 ? sub : pool;
    }
  }

  function topicLabel(q) {
    if (topicTitles && q && q.section && q.topic != null) {
      const sect = topicTitles[q.section];
      if (sect) {
        const entry = sect[q.topic] || sect[String(q.topic)];
        if (entry) return entry[lang] || entry.en || entry.bg || "";
      }
    }
    return "";
  }

  function topicTitleFor(section, topic) {
    if (topicTitles && topicTitles[section]) {
      const entry = topicTitles[section][topic] || topicTitles[section][String(topic)];
      if (entry) return entry[lang] || entry.en || entry.bg || "";
    }
    return section + " " + topic;
  }

  function pickQuestion() {
    if (!pool || !pool.length) return null;
    const eName = state && state.currentEnemy && state.currentEnemy.name;
    const p = (eName && enemyPools && enemyPools[eName]) || pool;
    return p[Math.floor(Math.random() * p.length)];
  }

  let state = null;

  function freshState() {
    return {
      lives: 3,
      score: 0,
      round: 1,
      kills: 0,
      correctSinceLife: 0,
      streak: 0,
      bestStreak: 0,
      currentEnemy: null,
      currentEnemyIdx: -1,
      currentHpMax: 0,
      currentHpLeft: 0,
      damageThisRound: 0,
      finishHimShown: false,
      currentQ: null,
      currentLocale: null,
      currentCorrect: -1,
      busy: false,
      topicStats: Object.create(null),
    };
  }

  function banner(text, kind, duration) {
    if (!els.banner) return;
    els.banner.className = "kombat-banner is-" + (kind || "default");
    els.banner.textContent = text;
    els.banner.removeAttribute("hidden");
    void els.banner.offsetWidth;
    els.banner.classList.add("is-shown");
    const dur = duration == null ? 1500 : duration;
    if (dur > 0) {
      clearTimeout(banner._t);
      banner._t = setTimeout(() => {
        els.banner.classList.remove("is-shown");
        els.banner.setAttribute("hidden", "");
      }, dur);
    }
  }

  function flash(kind) {
    els.fx.classList.remove("is-hit-hero", "is-hit-foe", "is-life-up");
    void els.fx.offsetWidth;
    els.fx.classList.add(kind);
  }

  function nextEnemy() {
    const idx = Math.min(state.round - 1, FINAL_IDX);
    const e = ENEMIES[idx];
    state.currentEnemy = e;
    state.currentEnemyIdx = idx;
    state.currentHpMax = e.hp;
    state.currentHpLeft = e.hp;
    state.damageThisRound = 0;
    state.finishHimShown = false;
    drawEnemy();
    drawHp();
    const showFight = () => banner(T.fight, "fight", 900);
    if (e.final) {
      banner(T.finalIncoming, "boss", 1300);
      setTimeout(showFight, 1350);
      setTimeout(showQuestion, 2350);
    } else if (e.boss) {
      banner(T.bossIncoming, "boss", 1100);
      setTimeout(showFight, 1150);
      setTimeout(showQuestion, 2100);
    } else {
      showFight();
      setTimeout(showQuestion, 950);
    }
  }

  function drawEnemy() {
    const e = state.currentEnemy;
    const labelName = e.final ? (T.bossPrefix + e.name) : (e.boss ? (e.name + " ★") : e.name);
    els.foeName.textContent = labelName;
    els.foeLabel.textContent = labelName;
    els.foeIcon.textContent = e.icon;
    els.foeIcon.style.color = e.color;
    els.foeHp.style.background = "linear-gradient(180deg, " + e.color + " 0%, #0a0a0a 100%)";
    els.foe.classList.toggle("kombat-fighter-final", !!e.final);
    els.foe.classList.toggle("kombat-fighter-boss", !!e.boss && !e.final);
  }

  function drawHp() {
    const pct = Math.max(0, state.currentHpLeft / state.currentHpMax) * 100;
    els.foeHp.style.width = pct + "%";
  }
  function drawHeroHp() {
    const pct = (state.lives / 3) * 100;
    els.heroHp.style.width = pct + "%";
    const hearts = els.lives.querySelectorAll(".kombat-life");
    hearts.forEach((h, i) => { h.style.opacity = i < state.lives ? "1" : "0.18"; });
  }
  function drawScore() {
    els.score.textContent = String(state.score).padStart(4, "0");
    els.round.textContent = state.round;
  }
  function drawStreak() {
    if (state.streak >= 5) {
      els.streakHud.removeAttribute("hidden");
      els.streakVal.textContent = state.streak;
      const m = streakMultiplier(state.streak);
      els.streakMult.textContent = " (" + m + T.multiplier + ")";
    } else {
      els.streakHud.setAttribute("hidden", "");
    }
  }

  function showQuestion() {
    const q = pickQuestion();
    if (!q) { gameOver(false); return; }
    state.currentQ = q;
    const loc = q[lang] || q.en || q.bg;
    state.currentLocale = loc;
    state.currentCorrect = (typeof loc.correct === "number") ? loc.correct : loc.answer;
    const meta = topicLabel(q);
    els.qMeta.textContent = meta ? ("Q · " + meta) : "Q";
    els.qStem.textContent = loc.stem;
    els.optionBtns.forEach((btn, i) => {
      btn.classList.remove("is-correct", "is-wrong");
      btn.disabled = false;
      const tt = btn.querySelector(".kombat-key-text");
      if (tt) tt.textContent = loc.options[i] != null ? loc.options[i] : "";
    });
    state.busy = false;
  }

  function streakMultiplier(streak) {
    if (streak >= 15) return 3;
    if (streak >= 10) return 2;
    if (streak >= 5)  return 1.5;
    return 1;
  }

  function recordTopicStat(q, ok) {
    if (!q || !q.section || q.topic == null) return;
    const key = q.section + ":" + q.topic;
    const slot = state.topicStats[key] ||
      (state.topicStats[key] = { correct: 0, wrong: 0, section: q.section, topic: q.topic });
    if (ok) slot.correct += 1; else slot.wrong += 1;
  }

  function handleAnswer(idx) {
    if (!state || state.busy) return;
    if (els.question.hasAttribute("hidden")) return;
    state.busy = true;
    const correct = idx === state.currentCorrect;
    const chosen = els.optionBtns[idx];
    if (chosen) chosen.classList.add(correct ? "is-correct" : "is-wrong");
    if (!correct) {
      const right = els.optionBtns[state.currentCorrect];
      if (right) right.classList.add("is-correct");
    }
    if (correct) onCorrect();
    else onWrong();
  }

  function onCorrect() {
    recordTopicStat(state.currentQ, true);
    const prevStreak = state.streak;
    state.streak += 1;
    if (state.streak > state.bestStreak) state.bestStreak = state.streak;
    const mult = streakMultiplier(state.streak);
    state.score += Math.round(100 * mult);
    state.currentHpLeft -= 1;
    state.correctSinceLife += 1;
    drawHp();
    drawScore();
    drawStreak();
    els.foe.classList.add("is-hit");
    flash("is-hit-foe");
    setTimeout(() => els.foe.classList.remove("is-hit"), 240);

    if (state.streak !== prevStreak &&
        (state.streak === 5 || state.streak === 10 || state.streak === 15 ||
         (state.streak > 15 && state.streak % 5 === 0))) {
      banner(state.streak + "× " + T.streak, "streak", 900);
    }

    if (state.currentHpLeft === 1 && !state.finishHimShown) {
      state.finishHimShown = true;
      setTimeout(() => banner(T.finishHim, "finish", 1100), 80);
    }

    if (state.correctSinceLife >= 10) {
      state.correctSinceLife = 0;
      if (state.lives < 3) {
        state.lives += 1;
        drawHeroHp();
        banner(T.extraLife, "life", 900);
        flash("is-life-up");
      }
    }

    if (state.currentHpLeft <= 0) {
      state.kills += 1;
      els.foe.classList.add("is-dead");
      const wasFlawless = state.damageThisRound === 0;
      const e = state.currentEnemy;
      const isFinal = !!e.final;
      const victoryText = isFinal ? T.finalVictory : (wasFlawless ? T.flawless : T.victory);
      const victoryKind = isFinal ? "flawless" : (wasFlawless ? "flawless" : "victory");
      setTimeout(() => banner(victoryText, victoryKind, 1500), 120);
      setTimeout(() => {
        els.foe.classList.remove("is-dead");
        if (isFinal) {
          gameOver(true);
        } else {
          state.round += 1;
          drawScore();
          nextEnemy();
        }
      }, 1700);
    } else {
      setTimeout(showQuestion, 700);
    }
  }

  function onWrong() {
    recordTopicStat(state.currentQ, false);
    const e = state.currentEnemy;
    const penalty = (e && (e.boss || e.final)) ? 2 : 1;
    state.lives = Math.max(0, state.lives - penalty);
    state.damageThisRound += penalty;
    state.streak = 0;
    drawHeroHp();
    drawStreak();
    flash("is-hit-hero");
    els.hero.classList.add("is-hit");
    if (penalty > 1) banner(T.doubleDamage, "boss", 900);
    else banner(T.ouch, "ouch", 700);
    setTimeout(() => els.hero.classList.remove("is-hit"), 240);
    if (state.lives <= 0) {
      setTimeout(() => gameOver(false), 1100);
    } else {
      setTimeout(showQuestion, 1100);
    }
  }

  function gameOver(victorious) {
    setDeck(false);
    showOverlay("gameover");
    els.finalScore.textContent = state.score;
    els.finalKills.textContent = state.kills;
    els.finalStreak.textContent = state.bestStreak;
    if (els.gameoverTitle) {
      els.gameoverTitle.textContent = victorious ? T.finalVictory : T.gameOver;
      els.gameoverTitle.classList.toggle("is-victorious", !!victorious);
    }
    renderWeakness();
    const board = loadBoard();
    const lowest = board.length < 10 ? 0 : board[board.length - 1].score;
    const qualifies = state.score > 0 && (board.length < 10 || state.score > lowest);
    if (qualifies) {
      els.newRec.removeAttribute("hidden");
      els.nameRow.removeAttribute("hidden");
      if (els.nameInput) els.nameInput.focus();
    } else {
      els.newRec.setAttribute("hidden", "");
      els.nameRow.setAttribute("hidden", "");
    }
  }

  function renderWeakness() {
    if (!els.weakness) return;
    const rows = Object.values(state.topicStats)
      .filter((s) => (s.correct + s.wrong) >= 2)
      .map((s) => ({ correct: s.correct, wrong: s.wrong, section: s.section, topic: s.topic,
                     total: s.correct + s.wrong, rate: s.wrong / (s.correct + s.wrong) }))
      .filter((s) => s.wrong > 0)
      .sort((a, b) => b.rate - a.rate || b.wrong - a.wrong)
      .slice(0, 3);
    if (!rows.length) {
      els.weakness.innerHTML = "";
      els.weakness.setAttribute("hidden", "");
      return;
    }
    els.weakness.removeAttribute("hidden");
    const items = rows.map((r) => {
      const title = topicTitleFor(r.section, r.topic);
      return '<li class="kombat-weak-row">' +
        '<span class="kombat-weak-title">' + escapeHtml(title) + '</span>' +
        '<span class="kombat-weak-count">' + r.wrong + " / " + r.total + ' ' + escapeHtml(T.wrongOf) + '</span>' +
      '</li>';
    }).join("");
    els.weakness.innerHTML =
      '<div class="kombat-weak-title-row">' + escapeHtml(T.worstTopics) + '</div>' +
      '<ol class="kombat-weak-list">' + items + '</ol>';
  }

  function loadBoard() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      const arr = JSON.parse(raw);
      if (!Array.isArray(arr)) return [];
      return arr.slice(0, 10);
    } catch (e) { return []; }
  }
  function saveBoard(board) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(board.slice(0, 10))); }
    catch (e) { /* ignore */ }
  }
  function renderBoard() {
    const board = loadBoard();
    if (!board.length) {
      els.boardList.innerHTML = '<li class="kombat-board-empty">' + escapeHtml(T.noLeaderboard) + '</li>';
      return;
    }
    els.boardList.innerHTML = board.map((entry, i) =>
      '<li class="kombat-board-row">' +
        '<span class="kombat-board-rank">' + (i + 1) + '</span>' +
        '<span class="kombat-board-name">' + escapeHtml(entry.name) + '</span>' +
        '<span class="kombat-board-score">' + entry.score + '</span>' +
      '</li>'
    ).join("");
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[c]);
  }
  function commitName() {
    if (!els.nameInput) return;
    const raw = (els.nameInput.value || "").trim().slice(0, 14);
    if (!raw) return;
    const board = loadBoard();
    board.push({ name: raw, score: state.score, kills: state.kills, at: Date.now() });
    board.sort((a, b) => b.score - a.score);
    saveBoard(board);
    els.nameRow.setAttribute("hidden", "");
    els.newRec.setAttribute("hidden", "");
  }

  root.querySelectorAll("[data-kombat-menu]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const action = btn.dataset.kombatMenu;
      if (action === "play") {
        await startGame();
      } else if (action === "leaderboard") {
        renderBoard();
        showOverlay("leaderboard");
      } else if (action === "help") {
        showOverlay("help");
      } else if (action === "menu") {
        setDeck(false);
        showOverlay("menu");
      }
    });
  });

  els.optionBtns.forEach((btn) => {
    btn.addEventListener("click", () => handleAnswer(parseInt(btn.dataset.kombatOption, 10)));
  });

  document.addEventListener("keydown", (ev) => {
    if (!state || state.busy) return;
    if (!els.options || els.options.hasAttribute("hidden")) return;
    const k = ev.key.toLowerCase();
    const map = { w: 0, a: 1, s: 2, d: 3, "1": 0, "2": 1, "3": 2, "4": 3 };
    if (k in map) {
      ev.preventDefault();
      handleAnswer(map[k]);
    }
  });

  els.saveBtn && els.saveBtn.addEventListener("click", commitName);
  els.nameInput && els.nameInput.addEventListener("keydown", (ev) => {
    if (ev.key === "Enter") { ev.preventDefault(); commitName(); }
  });

  async function startGame() {
    try {
      await loadPool();
      buildEnemyPools();
    } catch (e) {
      console.error(e);
      return;
    }
    state = freshState();
    drawHeroHp();
    drawScore();
    drawStreak();
    hideOverlay();
    setDeck(true);
    nextEnemy();
  }

  setDeck(false);
  showOverlay("menu");
})();
</script>

