  .kombat-board-col-name  { text-align: left;   overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .kombat-board-col-score { text-align: right;  color: var(--kg-yellow); }
  .kombat-board-col-round { text-align: right;  color: var(--kg-text-dim); }
  /* Empty (yet-to-be-claimed) slots — dim dashes so the table always
   * reads as a full top-10. */
  .kombat-board-row-empty .kombat-board-col-rank,
  .kombat-board-row-empty .kombat-board-col-name,
  .kombat-board-row-empty .kombat-board-col-score,
  .kombat-board-row-empty .kombat-board-col-round {
    color: rgba(245, 241, 216, 0.32);
    text-shadow: none;
  }
  /* Highlight the row the player just submitted. */
  .kombat-board-row.is-me {
    background: rgba(255, 224, 0, 0.18);
    box-shadow: inset 0 0 0 2px var(--kg-yellow);
    color: var(--kg-yellow);
  }
  .kombat-board-row.is-me .kombat-board-col-name,
  .kombat-board-row.is-me .kombat-board-col-round { color: var(--kg-yellow); }
  /* Legacy "no scores yet" rule retained as a defensive no-op in case
   * any older code path still pushes that li. */
  .kombat-board-empty {
    text-align: center;
    color: var(--kg-text-dim);
    padding: 16px;
  }

  .kombat-gameover-title {
    font-size: clamp(1.4rem, 4.2vw, 2.4rem);
    color: var(--kg-red);
    text-shadow: 4px 4px 0 #000, 0 0 24px var(--kg-blood);
    letter-spacing: 0.08em;
    text-align: center;
    align-self: center;
    width: 100%;
  }
  .kombat-gameover-title.is-victorious {
    background: linear-gradient(180deg, var(--kg-yellow) 0%, var(--kg-orange) 55%, var(--kg-red) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    text-shadow: none;
    filter: drop-shadow(4px 4px 0 #000) drop-shadow(0 0 22px rgba(255, 122, 24, 0.55));
  }
  .kombat-gameover-stats { display: grid; gap: 8px; font-size: 0.7rem; }
  .kombat-gameover-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: baseline;
  }
  .kombat-gameover-val { color: var(--kg-yellow); font-size: 1rem; }
  .kombat-gameover-highscore {
    color: var(--kg-yellow);
    letter-spacing: 0.12em;
    text-shadow: 2px 2px 0 #000;
    font-size: 0.7rem;
  }
  .kombat-gameover-name { display: grid; gap: 8px; width: 100%; max-width: 320px; }
  .kombat-gameover-name[hidden] { display: none; }
  .kombat-gameover-name label {
    font-size: 0.55rem;
    color: var(--kg-text-dim);
    letter-spacing: 0.12em;
    text-align: center;
  }
  .kombat-gameover-name input {
    appearance: none;
    background: #000;
    border: 2px solid var(--kg-yellow);
    color: var(--kg-yellow);
    padding: 10px 12px;
    font-family: inherit;
    font-size: 0.85rem;
    text-align: center;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
  }
  .kombat-gameover-name input:focus { outline: none; box-shadow: 0 0 0 2px var(--kg-orange); }
  .kombat-gameover-actions { display: grid; gap: 8px; width: min(320px, 90%); margin-top: 4px; }

  .kombat-weakness {
    width: min(520px, 100%);
    margin-top: 4px;
    padding: 10px 12px;
    background: rgba(224, 16, 16, 0.08);
    border: 2px solid var(--kg-blood);
    font-size: 0.55rem;
  }
  .kombat-weakness[hidden] { display: none; }
  .kombat-weak-title-row {
    text-align: center;
    color: var(--kg-red);
    letter-spacing: 0.14em;
    margin-bottom: 6px;
    text-shadow: 2px 2px 0 #000;
  }
  .kombat-weak-list { list-style: none; padding: 0; margin: 0; line-height: 1.55; }
  .kombat-weak-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 4px 0;
    align-items: baseline;
    color: var(--kg-text);
  }
  .kombat-weak-count { color: var(--kg-red); white-space: nowrap; }

  .kombat-deck {
    background:
      linear-gradient(180deg, var(--kg-deck) 0%, #0a0603 100%);
    border: 4px solid var(--kg-deck-trim);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    padding: 14px 16px 18px;
    box-shadow:
      inset 0 0 30px rgba(0, 0, 0, 0.7),
      inset 0 4px 0 rgba(255, 122, 24, 0.18);
    min-height: 220px;
  }
  .kombat-q {
    background: #000;
    border: 2px solid var(--kg-yellow);
    padding: 10px 12px;
    margin-bottom: 12px;
    box-shadow: inset 0 0 0 1px #1a1a1a, 4px 4px 0 #000;
  }
  .kombat-q[hidden] { display: none; }
  .kombat-q-meta {
    font-size: 0.5rem;
    color: var(--kg-yellow);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 4px;
  }
  .kombat-q-stem {
    font-size: clamp(0.65rem, 1.4vw, 0.8rem);
    line-height: 1.55;
    color: var(--kg-text);
  }
  .kombat-answers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .kombat-answers[hidden] { display: none; }
  .kombat-deck-hint {
    text-align: center;
    color: var(--kg-yellow);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    padding: 60px 0;
    text-shadow: 2px 2px 0 #000;
    animation: kombat-blink 1.1s steps(2) infinite;
  }
  .kombat-deck-hint[hidden] { display: none; }

  .kombat-key {
    appearance: none;
    display: grid;
    grid-template-columns: 28px 22px 1fr;
    align-items: center;
    gap: 8px;
    background: linear-gradient(180deg, var(--kg-key-bg-1) 0%, var(--kg-key-bg-2) 100%);
    border: 2px solid #000;
    color: var(--kg-text);
    padding: 12px 14px;
    font-family: inherit;
    font-size: 0.6rem;
    line-height: 1.45;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--kg-key-shadow);
    transition: transform 90ms ease, background 120ms ease, border-color 120ms ease;
    min-height: 64px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  /* Gate :hover to real mouse devices — iOS Safari fires a phantom
   * :hover after each tap that sticks until the next tap, which kept
   * a previously-chosen card looking different from its peers. */
  @media (hover: hover) {
    .kombat-key:hover { border-color: var(--kg-yellow); }
  }
  .kombat-key:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #000, inset 0 0 0 1px #444;
  }
  .kombat-key-letter {
    color: var(--kg-yellow);
    font-size: 0.85rem;
    text-align: center;
    text-shadow: 2px 2px 0 #000;
  }
  .kombat-key-num {
    color: var(--kg-text-dim);
    font-size: 0.55rem;
    text-align: center;
  }
  .kombat-key-text {
    color: var(--kg-text);
    overflow-wrap: anywhere;
  }
  .kombat-key.is-correct {
    background: linear-gradient(180deg, #0e5a0e 0%, #052f05 100%);
    border-color: var(--kg-green);
  }
  .kombat-key.is-wrong {
    background: linear-gradient(180deg, #6a0e0e 0%, #2f0505 100%);
    border-color: #ff4040;
  }

  /* (.kombat-fs-toggle rules removed — the user-clickable toggle was
   * deleted from the cabinet. The :fullscreen / pseudo-fs styles below
   * still apply because the silent PUSH START auto-FS attempt can land
   * a true fullscreen on browsers that allow it.) */

  /* Native :fullscreen state — keep the cabinet unwrapped for true FS */
  .kombat-cabinet:fullscreen,
  .kombat-cabinet:-webkit-full-screen {
    background: #000;
    border-radius: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
  }
  .kombat-cabinet:fullscreen .kombat-marquee,
  .kombat-cabinet:-webkit-full-screen .kombat-marquee { display: none; }
  .kombat-cabinet:fullscreen .kombat-bezel,
  .kombat-cabinet:-webkit-full-screen .kombat-bezel {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  .kombat-cabinet:fullscreen .kombat-screen,
  .kombat-cabinet:-webkit-full-screen .kombat-screen {
    flex: 1;
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
  }

  /* Pseudo-fullscreen — used on iPhone Safari which can't FS arbitrary
     elements. Lift the whole cabinet over everything. */
  .kombat-cabinet.is-pseudo-fs {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100vw;
    height: 100vh;
    aspect-ratio: auto;        /* override the 5/7 portrait constraint */
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border-radius: 0;
    background: #000;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
  }
  .kombat-cabinet.is-pseudo-fs .kombat-marquee { display: none; }
  .kombat-cabinet.is-pseudo-fs .kombat-bezel {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    border-radius: 0;
  }
  .kombat-cabinet.is-pseudo-fs .kombat-screen {
    flex: 1;
    aspect-ratio: auto;
    min-height: 50vh;
    border: 0;
    border-radius: 0;
  }
  /* Lock page scroll behind the pseudo-fs cabinet */
  :global(body.kombat-fs-lock) {
    overflow: hidden !important;
    height: 100vh !important;
    touch-action: none;
  }

  /* ============================================================
   * iPhone / touch-first layout
   * Triggered on small viewports or coarse pointers (any touch device).
   * - Cabinet/bezel chrome dropped: arcade vibe survives via CRT + photo.
   * - Stage uses min-height instead of aspect-ratio so it never clips.
   * - Answers stack 1-col, ≥56px tap targets, no WASD letters.
   * - Question stem + answer text in a system sans (pixel font is unreadable
   *   for long Cyrillic). Press Start 2P stays on HUD / banners / logo.
   * - Safe-area-inset-bottom respects iPhone home indicator.
   * ============================================================ */
  @media (max-width: 759px), (pointer: coarse) {
    /* Mobile cabinet now fills the viewport instead of locking to a
     * 5:7 aspect-ratio (which left ~30% black dead-space at the bottom
     * of short rounds). It still floats inside the body padding
     * (safe-area top/bottom, 16 px sides) with a 4dvh margin so the
     * MK arcade-cabinet framing reads, but its height is computed:
     *
     *   cabinet height = 100dvh − safe-area-top − safe-area-bottom − 8dvh
     *                  (8dvh = 4dvh top margin + 4dvh bottom margin)
     *
     * On a 390×844 iPhone 14 Pro (safe-area 59 + 34):
     *   cabinet = 358 × 683 px (vs 358 × 501 px under the old 5:7 lock).
     *
     * Internal flex (see further down) distributes that height between
     * screen + deck, and the answer cards' grid-auto-rows now uses
     * minmax(44 px, 1fr) so each card grows when there's room rather
     * than leaving a black gap below them. */
    .kombat-cabinet {
      width: 100%;
      max-width: 100%;
      height: calc(100dvh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 8dvh);
      margin: 4dvh auto;
      padding: 0;
      border-radius: 12px;
      background: #000;
      box-shadow:
        0 0 0 2px #1a1a1a,
        0 0 0 3px rgba(255, 224, 0, 0.10),
        0 18px 50px rgba(0, 0, 0, 0.7);
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
    }
    .kombat-marquee { padding: 4px 6px; font-size: 0.5rem; }
    .kombat-bezel {
      background: transparent;
      border: 0;
      border-radius: 0;
      padding: 0;
      box-shadow: none;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    /* Stage uses 100dvh (dynamic-viewport) so iOS URL-bar resize doesn't
     * push the answer cards off-screen. Behaviour depends on state:
     *  - non-playing (menu / help / leaderboard / gameover): screen
     *    flex:1, fills the whole bezel so the overlay covers cabinet
     *    edge-to-edge with no dead deck.
     *  - playing: screen is bounded so the deck has room for the
     *    question + 4 answer cards underneath. */
    .kombat-screen {
      aspect-ratio: auto;
      border: 0;
      border-radius: 0;
      box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.85);
      flex: 1;
      min-height: 0;
    }
    /* Cabinet now has a finite height (≈501 px on iPhone 14 Pro because
     * width-driven aspect 5:7). Screen + deck share bezel by flex
     * weight, with the deck getting the lion's share so a multi-line
     * question stem + the four answer cards all fit without scroll.
     * Screen 2, deck 5 → ~29/71 split. Bezel ≈ 481 px → screen ≈ 137 px
     * (HUD + small fighters), deck ≈ 344 px. */
    .kombat-cabinet[data-kombat-state="playing"] .kombat-screen {
      flex: 2 1 0;
      min-height: 0;
      max-height: none;
    }
    .kombat-hud {
      inset: 4px 6px auto 6px;
      gap: 4px;
      grid-template-columns: 1fr 1fr;  /* drop center column; round in arena */
    }
    .kombat-hud-center {
      grid-column: 1 / -1;
      order: -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 2px;
    }
    .kombat-hud-vs { display: none; }       /* redundant on mobile */
    .kombat-hud-score { font-size: clamp(0.85rem, 4.2vw, 1.1rem); margin: 0; }
    .kombat-hud-label {
      font-size: clamp(7px, 2vw, 10px);
      max-width: 46vw;
      letter-spacing: 0.08em;
    }
    .kombat-hud-label.is-latin { font-size: clamp(10px, 3vw, 13px); }
    .kombat-hp-bar { width: 100%; height: 7px; }
    .kombat-hud-meta { font-size: clamp(7px, 2vw, 9px); }
    .kombat-lives { font-size: 0.7rem; gap: 2px; }
    /* Fighters: compress to ~80px each so they stay recognisable but
     * don't eat the answer-cards budget. */
    .kombat-arena { inset: 64px 6px 6px; }
    .kombat-portrait-fallback {
      font-size: clamp(2.6rem, 9vw, 4rem);
      line-height: 0.85;
    }
    .kombat-foe-emoji {
      font-size: clamp(3rem, 11vw, 5rem);
      line-height: 0.85;
    }
    .kombat-fighter-name { font-size: clamp(8px, 2.2vw, 11px); margin-top: 4px; }
    .kombat-fighter-name.is-latin { font-size: clamp(10px, 2.6vw, 13px); }
    .kombat-banner { top: 38%; font-size: clamp(1.1rem, 6vw, 1.8rem); }
    .kombat-banner.is-streak,
    .kombat-banner.is-life,
    .kombat-banner.is-ouch { font-size: clamp(0.9rem, 4.5vw, 1.3rem); }

    /* Deck takes the larger ~71% of the bezel (weight 5 vs screen 2)
     * so a multi-line question stem and the four answer cards both
     * fit. min-height:0 + the flex children below ensure correct
     * sharing inside this column. */
    .kombat-deck {
      background: linear-gradient(180deg, #14110a 0%, #050402 100%);
      border: 0;
      border-radius: 0;
      padding: 6px 8px 8px;
      min-height: 0;
      flex: 5 1 0;
      box-shadow: inset 0 3px 0 rgba(255, 224, 0, 0.10);
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    /* Retro question dialog: yellow border, black bg, hard 3px drop-
     * shadow. Now sized to its content with bounds:
     *  - min-height 80 px so a 1-line question doesn't collapse;
     *  - max-height 40% of the deck so a giant stem can't push the
     *    answer cards off screen (internal scroll catches the rest).
     * flex: 0 1 auto = take content size, don't grow into spare space
     * (that's what the answer cards do instead). */
    .kombat-q {
      margin-bottom: 0;
      padding: 6px 9px;
      flex: 0 1 auto;
      min-height: 80px;
      max-height: 40%;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background: #000;
      border: 2px solid var(--kg-yellow);
      box-shadow: 3px 3px 0 #000;
    }
    .kombat-q-meta { font-size: clamp(7px, 2vw, 9px); margin-bottom: 2px; }
    .kombat-q-stem {
      /* Pure pixel font everywhere — Press Start 2P inherits from the
       * cabinet root. Tiny size + tall line-height + hard text-shadow
       * keeps Cyrillic legible-as-shapes even though individual glyphs
       * read as pixel art. */
      font-size: clamp(8px, 2.6vw, 11px);
      line-height: 1.75;
      letter-spacing: 0.02em;
      text-shadow: 1px 1px 0 #000;
    }
    /* Answers grow with the deck — grid-auto-rows minmax(44 px, 1fr)
     * means each card is at least the WCAG tap floor but expands to
     * fill any leftover space when the question is short. flex: 1 1 0
     * makes the answers row consume all height the question doesn't,
     * killing the dead-space-below-cards bug. */
    .kombat-answers {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(44px, 1fr);
      gap: 6px;
      flex: 1 1 0;
      min-height: 0;
    }
    /* Retro answer cards: yellow border, hard 3px drop-shadow, gradient
     * panel, Press-Start-2P digit + pixel-font answer text. Height is
     * now driven by the grid-auto-rows minmax(44 px, 1fr) above — cards
     * are at least 44 px tall and grow when the question doesn't claim
     * the deck. */
    .kombat-key {
      grid-template-columns: 22px 1fr;
      min-height: 44px;
      height: auto;
      padding: 4px 8px;
      gap: 7px;
      background: linear-gradient(180deg, #2a2a2a 0%, #0a0a0a 100%);
      border: 2px solid var(--kg-yellow);
      color: var(--kg-text);
      box-shadow: 3px 3px 0 #000;
      font-size: clamp(7px, 2.2vw, 9px);
      line-height: 1.6;
      letter-spacing: 0.02em;
      text-shadow: 1px 1px 0 #000;
      align-items: center;
    }
    /* Only :active (live tap-down) triggers the press effect.
     * :focus / :focus-visible / :hover are excluded because iOS Safari
     * sticks them after the tap and the previously-chosen card would
     * keep looking "pressed" into the next question. */
    .kombat-key:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 #000, inset 0 0 0 1px rgba(255, 224, 0, 0.45);
      border-color: var(--kg-yellow-h);
    }
    .kombat-key:focus,
    .kombat-key:focus-visible {
      outline: none;
      /* No border-color / shadow change — the card stays default yellow. */
    }
    .kombat-key-letter { display: none; }  /* WASD label meaningless on touch */
    .kombat-key-num {
      display: block;
      font-family: "Press Start 2P", monospace;
      color: var(--kg-yellow);
      font-size: 0.85rem;
      text-shadow: 2px 2px 0 #000;
      text-align: center;
    }
    .kombat-key.is-correct {
      background: linear-gradient(180deg, #1f7a1f 0%, #0a3d0a 100%);
      border-color: var(--kg-green);
    }
    .kombat-key.is-wrong {
      background: linear-gradient(180deg, #7a1f1f 0%, #3d0a0a 100%);
      border-color: #ff4040;
    }
    .kombat-key-letter { display: none; }  /* WASD label is meaningless on touch */
    .kombat-key-num {
      color: var(--kg-yellow);
      font-size: 1.05rem;
      font-family: "Press Start 2P", monospace;
    }
    /* (Older mobile :hover / :active+focus-visible duplicate removed —
     * superseded by the retro answer-card rules higher in this @media
     * block, which already gate :hover via (hover:hover) and drop the
     * sticky :focus state.) */
    .kombat-deck-hint { padding: 24px 0; font-size: 0.6rem; }

    /* Overlays: top-aligned, scrollable, safe-area aware. The menu screen
     * tends to overflow on a 390×844 viewport when all four CTAs are
     * shown; explicit overflow-y so the КАК СЕ ИГРАЕ button stays
     * reachable. padding-top 32px gives the logo clearance from the
     * marquee strip above the stage. */
    .kombat-overlay {
      align-content: start;
      align-items: start;
      justify-content: start;
      gap: 12px;
      padding: 32px 18px calc(32px + env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    /* The menu overlay is taller than most — guarantee a scroll thumb is
     * available even with the on-screen keyboard / iOS chrome. */
    .kombat-menu { padding-bottom: calc(48px + env(safe-area-inset-bottom, 0px)); }
    .kombat-logo { font-size: clamp(1.8rem, 9vw, 2.8rem); }
    .kombat-logo-sub { font-size: 0.55rem; }
    .kombat-push { font-size: 0.75rem; }
    .kombat-cab-btn { min-height: 48px; padding: 14px 16px; font-size: 0.7rem; }
    .kombat-cab-btn:hover { border-color: #000; }
    .kombat-cab-btn:active,
    .kombat-cab-btn:focus-visible { border-color: var(--kg-yellow); }
    .kombat-cab-btn-primary:hover {
      background: linear-gradient(180deg, var(--kg-yellow) 0%, var(--kg-orange) 100%);
    }
    .kombat-overlay-title { font-size: clamp(0.95rem, 4.5vw, 1.3rem); }
    .kombat-help-list { font-size: 0.6rem; }
    /* Tighten the high-score table for the ~330 px wide cabinet — the
     * desktop 28/64/56 column widths would overflow. display: grid is
     * re-stated so a future CSS audit doesn't accidentally drop it
     * through the cascade. */
    .kombat-board-frame { width: 100%; box-shadow: 3px 3px 0 #000; }
    .kombat-board-head,
    .kombat-board-row {
      display: grid;
      grid-template-columns: 24px 1fr 50px 48px;
      column-gap: 8px;
      row-gap: 0;
      padding: 7px 9px;
      align-items: center;
    }
    .kombat-board-head { font-size: 8px; letter-spacing: 0.06em; }
    .kombat-board-list { font-size: 9px; line-height: 1.4; }
    .kombat-board-col-name  { font-size: 9px; }
