---
import { type Lang, ui } from "../i18n/ui";
import { getTopicsByLang, groupTopics, topicPath, type TopicEntry } from "../lib/topics";

interface Props {
  lang: Lang;
  active?: string;
  drawer?: boolean;
}
const { lang, active, drawer = false } = Astro.props;
const t = ui[lang];
const all = await getTopicsByLang(lang);
const { preface, ortho, trauma } = groupTopics(all);

function isActive(e: TopicEntry) { return e.slug === active; }
---
<aside class={drawer ? "drawer-panel" : "sidebar hidden lg:block"}>
  <nav aria-label={t.contents}>
    {preface && (
      <a href={topicPath(lang, preface)} class:list={["sidebar-link", isActive(preface) && "is-active"]}>
        <span class="num">·</span>
        {preface.data.title}
      </a>
    )}

    <div class="sidebar-section-label">{t.sectionOrtho}</div>
    {ortho.map((e) => (
      <a href={topicPath(lang, e)} class:list={["sidebar-link", isActive(e) && "is-active"]}>
        <span class="num">{e.data.topicNumber}</span>
        <span>{e.data.title}</span>
      </a>
    ))}

    <div class="sidebar-section-label">{t.sectionTrauma}</div>
    {trauma.map((e) => (
      <a href={topicPath(lang, e)} class:list={["sidebar-link", isActive(e) && "is-active"]}>
        <span class="num">{e.data.topicNumber}</span>
        <span>{e.data.title}</span>
      </a>
    ))}
  </nav>
</aside>
