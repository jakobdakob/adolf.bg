---
import { ViewTransitions } from "astro:transitions";
import { type Lang, ui } from "../i18n/ui";
import Header from "../components/Header.astro";
import { url } from "../lib/topics";
import "../styles/global.css";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  otherPath: string;
  currentSection?: "ortho" | "trauma" | "preface" | "home";
  showMenuButton?: boolean;
}
const { lang, title, description, otherPath, currentSection = "home", showMenuButton = false } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.siteTitle}` : `${t.siteTitle} — ${t.siteTagline}`;
const desc = description ?? t.siteTagline;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#FAF9F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F0F12" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" hreflang={lang === "bg" ? "en" : "bg"} href={otherPath} />
    <link rel="alternate" hreflang="x-default" href={url("/bg/")} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content="adolf.bg" />
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem("adolf-theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (_) {}
      })();
    </script>
    <ViewTransitions />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header lang={lang} otherPath={otherPath} currentSection={currentSection} showMenuButton={showMenuButton} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© 2026 · adolf.bg</span>
        <span aria-hidden="true">·</span>
        <span>{t.siteTagline}</span>
      </div>
    </footer>

    <script is:inline>
      // Subtle scroll-reveal — opt-in by JS marking elements 'pending',
      // then unmarking when visible. Default state is visible.
      (function () {
        if (!("IntersectionObserver" in window)) return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.setAttribute("data-pending", "false");
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        }, { threshold: 0.08, rootMargin: "0px 0px -6% 0px" });
        const wire = () => {
          document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
            el.setAttribute("data-pending", "true");
            io.observe(el);
            // Failsafe: if not visible within 1.2s, force reveal.
            setTimeout(() => {
              el.setAttribute("data-pending", "false");
              el.classList.add("is-visible");
            }, 1200);
          });
        };
        wire();
        document.addEventListener("astro:after-swap", wire);
      })();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      .skip-link:focus {
        left: var(--s-4);
        top: var(--s-3);
        background: var(--ink);
        color: var(--bg);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        z-index: 100;
      }
    </style>
  </body>
</html>
