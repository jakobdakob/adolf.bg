---
// View Transitions intentionally disabled — Safari iOS misreports them as
// a redirect chain and aborts with "Load cannot follow more than 20
// redirections". Normal full-page loads instead.
import { type Lang, ui } from "../i18n/ui";
import Header from "../components/Header.astro";
import SearchModal from "../components/SearchModal.astro";
import SiteDrawer from "../components/SiteDrawer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { url } from "../lib/topics";
import { legalNav } from "../i18n/legal";
import "../styles/global.css";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  otherPath: string;
  currentSection?: "ortho" | "trauma" | "anatomy" | "preface" | "qbank" | "home";
  showMenuButton?: boolean;
  /** Pre-select this section's tab in the drawer. */
  drawerSection?: "ortho" | "trauma" | "anatomy";
  /** Slug of the current topic (for active state in drawer). */
  activeSlug?: string;
}
const { lang, title, description, otherPath, currentSection = "home", showMenuButton = true, drawerSection, activeSlug } = Astro.props;
const initialSection: "ortho" | "trauma" | "anatomy" =
  drawerSection ?? (currentSection === "trauma" || currentSection === "anatomy" ? currentSection : "ortho");
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.siteTitle}` : `${t.siteTitle} · ${t.siteTagline}`;
const desc = description ?? t.siteTagline;

const siteOrigin = Astro.site?.origin ?? "https://adolf.bg";
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const otherAbs = new URL(otherPath, siteOrigin).href;
const defaultAbs = new URL(url("/bg/"), siteOrigin).href;
const ogImage = new URL(url("/og-image.png"), siteOrigin).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#FAF9F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F0F12" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === "bg" ? "en" : "bg"} href={otherAbs} />
    <link rel="alternate" hreflang="x-default" href={defaultAbs} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href={url("/apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content="adolf.bg" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "bg" ? "bg_BG" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem("adolf-theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      // Figure lightbox — click any <figure class="md-figure"> image to enlarge.
      (function () {
        function wire() {
          var triggers = document.querySelectorAll("[data-figure-src]");
          if (!triggers.length) return;
          var overlay = document.getElementById("md-figure-lightbox-overlay");
          if (!overlay) {
            overlay = document.createElement("div");
            overlay.id = "md-figure-lightbox-overlay";
            overlay.className = "md-figure-lightbox";
            overlay.setAttribute("hidden", "");
            overlay.innerHTML = '<img alt="">';
            document.body.appendChild(overlay);
          }
          var img = overlay.querySelector("img");
          function open(src, alt) {
            img.src = src;
            img.alt = alt || "";
            overlay.removeAttribute("hidden");
            document.body.style.overflow = "hidden";
          }
          function close() {
            overlay.setAttribute("hidden", "");
            img.src = "";
            document.body.style.overflow = "";
          }
          overlay.addEventListener("click", close);
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !overlay.hasAttribute("hidden")) close();
          });
          triggers.forEach(function (t) {
            t.addEventListener("click", function () {
              open(t.dataset.figureSrc, t.dataset.figureAlt);
            });
          });
        }
        if (document.readyState !== "loading") wire();
        else document.addEventListener("DOMContentLoaded", wire);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header lang={lang} otherPath={otherPath} currentSection={currentSection} showMenuButton={showMenuButton} />
    <SiteDrawer lang={lang} active={activeSlug} section={initialSection} />
    <main id="main">
      <slot />
    </main>
    <SearchModal lang={lang} />
    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© 2026 · adolf.bg</span>
        <span aria-hidden="true">·</span>
        <span>{t.siteTagline}</span>
      </div>
      <nav class="site-footer-legal" aria-label="Legal">
        <a href={`/${lang}/legal/terms/`}>{legalNav[lang].terms}</a>
        <a href={`/${lang}/legal/privacy/`}>{legalNav[lang].privacy}</a>
        <a href={`/${lang}/legal/refund/`}>{legalNav[lang].refund}</a>
        <a href={`/${lang}/legal/imprint/`}>{legalNav[lang].imprint}</a>
      </nav>
    </footer>
    <CookieBanner lang={lang} />

    <script is:inline>
      // Subtle scroll-reveal — opt-in by JS marking elements 'pending',
      // then unmarking when visible. Default state is visible.
      (function () {
        if (!("IntersectionObserver" in window)) return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.setAttribute("data-pending", "false");
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        }, { threshold: 0.08, rootMargin: "0px 0px -6% 0px" });
        const wire = () => {
          document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
            el.setAttribute("data-pending", "true");
            io.observe(el);
            // Failsafe: if not visible within 1.2s, force reveal.
            setTimeout(() => {
              el.setAttribute("data-pending", "false");
              el.classList.add("is-visible");
            }, 1200);
          });
        };
        wire();
        document.addEventListener("astro:after-swap", wire);
      })();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      .skip-link:focus {
        left: var(--s-4);
        top: var(--s-3);
        background: var(--ink);
        color: var(--bg);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        z-index: 100;
      }
    </style>
  </body>
</html>
