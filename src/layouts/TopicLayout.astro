---
import BaseLayout from "./BaseLayout.astro";
import TopicSidebar from "../components/TopicSidebar.astro";
import TopicTOC from "../components/TopicTOC.astro";
import { type Lang, ui } from "../i18n/ui";
import { getTopicsByLang, topicPath, url as pathUrl, type TopicEntry } from "../lib/topics";

interface Heading { depth: number; slug: string; text: string }

interface Props {
  lang: Lang;
  entry: TopicEntry;
  otherPath: string;
  headings?: Heading[];
}
const { lang, entry, otherPath, headings = [] } = Astro.props;
const t = ui[lang];

const allEntries = await getTopicsByLang(lang);

const section: "ortho" | "trauma" | "anatomy" | "preface" =
  entry.data.kind === "preface" ? "preface" :
  (entry.data.section as any) ?? "ortho";

// prev/next stay within the current section so end-of-Ortho doesn't jump into
// Trauma. Section switching happens via the top nav.
const sectionTopics = allEntries.filter(
  (e) => e.data.kind === "topic" && e.data.section === section
);
const idx = sectionTopics.findIndex((e) => e.slug === entry.slug);
const prev = idx > 0 ? sectionTopics[idx - 1] : undefined;
const next = idx >= 0 && idx < sectionTopics.length - 1 ? sectionTopics[idx + 1] : undefined;

function sectionLabel(s?: string): string {
  if (s === "ortho") return t.sectionOrtho;
  if (s === "trauma") return t.sectionTrauma;
  if (s === "anatomy") return t.sectionAnatomy;
  return t.preface;
}

const eyebrow =
  entry.data.kind === "preface"
    ? t.preface
    : `${sectionLabel(entry.data.section)} · ${t.topicNumberLabel(entry.data.topicNumber!)}`;

// Bilingual toast — shown when stubbed CTAs are clicked in Pass A.
---
<BaseLayout
  lang={lang}
  title={entry.data.title}
  otherPath={otherPath}
  currentSection={section as any}
  activeSlug={entry.slug}
  drawerSection={(section === "preface" ? "ortho" : section) as any}
>
  <div class="topic-shell">
    <TopicSidebar lang={lang} active={entry.slug} section={section === "preface" ? "ortho" : section} />
    <article class="topic-article" data-topic-article data-pagefind-body>
      <span class="eyebrow topic-eyebrow">{eyebrow}</span>
      <div class="prose" data-topic-prose>
        <h1 class="topic-title">{entry.data.title}</h1>
        <slot />
      </div>
    </article>
    <TopicTOC lang={lang} headings={headings} />
  </div>
<script>
  // Force <details> in topic-section to stay open.
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.prose .topic-section details').forEach(d => {
      d.open = true;
      d.addEventListener('toggle', () => { if (!d.open) d.open = true; });
    });
  });

  // Desktop only: synchronized two-column book layout with fixed-positioned columns.
  (function () {
    if (window.matchMedia('(max-width: 1179px)').matches) return;

    function setupBookLayout() {
      const article = document.querySelector('.topic-article');
      const prose = article && article.querySelector('.prose');
      if (!prose || prose.dataset.bookReady === '1') return;
      prose.dataset.bookReady = '1';

      const layoutEl = document.createElement('div');
      layoutEl.className = 'book-layout';
      const col1 = document.createElement('div');
      col1.className = 'book-col';
      const col1Inner = document.createElement('div');
      col1Inner.className = 'book-col-inner';
      col1.appendChild(col1Inner);
      const col2 = document.createElement('div');
      col2.className = 'book-col';
      const col2Inner = document.createElement('div');
      col2Inner.className = 'book-col-inner';
      col2.appendChild(col2Inner);
      layoutEl.appendChild(col1);
      layoutEl.appendChild(col2);

      // Move prose children into col1Inner, then clone to col2Inner
      while (prose.firstChild) col1Inner.appendChild(prose.firstChild);
      col2Inner.innerHTML = col1Inner.innerHTML;

      // Hide the original prose visually (book-layout takes over)
      prose.style.display = 'none';
      document.body.appendChild(layoutEl);

      function positionLayout() {
        const articleRect = article.getBoundingClientRect();
        layoutEl.style.left = (articleRect.left) + 'px';
        layoutEl.style.width = (articleRect.width) + 'px';
      }
      positionLayout();

      // Setup spacer to drive page scroll
      const articleStyle = window.getComputedStyle(article);
      const contentHeight = col1Inner.scrollHeight;
      const colHeight = layoutEl.clientHeight;
      const spacer = document.createElement('div');
      spacer.style.height = (contentHeight + colHeight) + 'px';
      spacer.style.gridColumn = '2';
      spacer.style.pointerEvents = 'none';
      spacer.setAttribute('aria-hidden', 'true');
      article.appendChild(spacer);

      function onScroll() {
        const articleTop = article.getBoundingClientRect().top + window.scrollY;
        const y = Math.max(0, window.scrollY - articleTop + 0);
        col1Inner.style.transform = 'translateY(' + (-y) + 'px)';
        col2Inner.style.transform = 'translateY(' + (-(y + colHeight)) + 'px)';
      }

      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { positionLayout(); onScroll(); });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupBookLayout);
    } else {
      setupBookLayout();
    }
  })();
</script>


{entry.data.kind === "topic" && entry.data.section && entry.data.topicNumber && (
  <div class="topic-bottom-bar">
    {prev ? (
      <a href={topicPath(lang, prev)} class="tbb-btn tbb-prev" rel="prev" aria-label={t.prev}>
        <span aria-hidden="true">←</span>
      </a>
    ) : <span class="tbb-btn tbb-prev tbb-disabled" aria-hidden="true">←</span>}
    <a class="tbb-test" href={pathUrl(`/${lang}/${entry.data.section}/${entry.data.topicNumber}/test/`)}>
      {t.testYourself}
    </a>
    {next ? (
      <a href={topicPath(lang, next)} class="tbb-btn tbb-next" rel="next" aria-label={t.next}>
        <span aria-hidden="true">→</span>
      </a>
    ) : <span class="tbb-btn tbb-next tbb-disabled" aria-hidden="true">→</span>}
  </div>
)}

</BaseLayout>



<style>
  .topic-shell {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: var(--s-7);
    padding-bottom: var(--s-9);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }
  @media (min-width: 1024px) {
    .topic-shell {
      grid-template-columns: 240px minmax(0, 1fr) 240px;
      gap: var(--s-6);
    }
  }
  @media (min-width: 1180px) {
    .topic-shell {
      grid-template-columns: 240px minmax(0, 1fr) 240px;
      gap: var(--s-6);
    }
  }
  .topic-article {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
  }
  /* Section/topic label above title is redundant with the left sidebar
     (section name) and right TOC ("В тази тема") when both rails are visible.
     Hide it on lg+ where the sidebar is showing; keep on smaller screens
     where the sidebar is in the mobile drawer. */
  @media (min-width: 1024px) {
    .topic-eyebrow { display: none; }
  }
  .section-progress {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: flex;
    gap: 3px;
    align-items: stretch;
    width: 100%;
  }
  .sp-dot {
    flex: 1 1 0;
    min-width: 0;
    display: block;
  }
  .sp-link,
  .sp-current {
    display: block;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    transition: background-color 160ms var(--ease), transform 200ms var(--ease);
  }
  .sp-link:hover {
    background: var(--accent);
    transform: scaleY(1.6);
  }
  .sp-current {
    background: var(--accent);
    height: 6px;
    margin-top: -1px;
  }

  .topic-title {
    /* ~1.5× body text (body = 1.0625rem). Calm, not display-size. */
    font-size: 1.625rem;
    font-weight: 650;
    letter-spacing: -0.012em;
    line-height: 1.3;
    margin: 0 0 var(--s-6);
    max-width: 38ch;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .topic-prev-next {
    display: flex;
    gap: var(--s-5);
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    align-items: flex-start;
    justify-content: space-between;
  }
  .pn { display: block; max-width: 22ch; }
  .pn-next { margin-left: auto; text-align: right; }
  .pn-label {
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-muted);
    margin-bottom: var(--s-1);
  }
  .pn-title {
    font-size: var(--fs-body);
    color: var(--ink);
    font-weight: 500;
    transition: color 160ms var(--ease);
  }
  .pn:hover .pn-title { color: var(--accent); }

  .test-yourself {
    margin-top: var(--s-8);
    display: flex;
    justify-content: center;
  }
  .test-yourself-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    background: transparent;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    transition: background 160ms var(--ease), color 160ms var(--ease), transform 220ms var(--ease);
  }
  .test-yourself-cta:hover {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-1px);
  }
  .test-yourself-arrow {
    font-size: 1.1em;
    transition: transform 220ms var(--ease);
  }
  .test-yourself-cta:hover .test-yourself-arrow {
    transform: translateX(3px);
  }
</style>
