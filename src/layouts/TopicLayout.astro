---
import BaseLayout from "./BaseLayout.astro";
import TopicSidebar from "../components/TopicSidebar.astro";
import TopicTOC from "../components/TopicTOC.astro";
import { type Lang, ui } from "../i18n/ui";
import { getTopicsByLang, topicPath, url as pathUrl, type TopicEntry } from "../lib/topics";

interface Heading { depth: number; slug: string; text: string }

interface Props {
  lang: Lang;
  entry: TopicEntry;
  otherPath: string;
  headings?: Heading[];
}
const { lang, entry, otherPath, headings = [] } = Astro.props;
const t = ui[lang];

const allEntries = await getTopicsByLang(lang);

const section: "ortho" | "trauma" | "anatomy" | "preface" =
  entry.data.kind === "preface" ? "preface" :
  (entry.data.section as any) ?? "ortho";

// prev/next stay within the current section so end-of-Ortho doesn't jump into
// Trauma. Section switching happens via the top nav.
const sectionTopics = allEntries.filter(
  (e) => e.data.kind === "topic" && e.data.section === section
);
const idx = sectionTopics.findIndex((e) => e.slug === entry.slug);
const prev = idx > 0 ? sectionTopics[idx - 1] : undefined;
const next = idx >= 0 && idx < sectionTopics.length - 1 ? sectionTopics[idx + 1] : undefined;

function sectionLabel(s?: string): string {
  if (s === "ortho") return t.sectionOrtho;
  if (s === "trauma") return t.sectionTrauma;
  if (s === "anatomy") return t.sectionAnatomy;
  return t.preface;
}

const eyebrow =
  entry.data.kind === "preface"
    ? t.preface
    : `${sectionLabel(entry.data.section)} · ${t.topicNumberLabel(entry.data.topicNumber!)}`;

// Bilingual toast — shown when stubbed CTAs are clicked in Pass A.
const toastText = "Stripe Checkout е в процес на интегриране • Stripe Checkout coming in next push";
---
<BaseLayout
  lang={lang}
  title={entry.data.title}
  otherPath={otherPath}
  currentSection={section as any}
  activeSlug={entry.slug}
  drawerSection={(section === "preface" ? "ortho" : section) as any}
>
  <div class="topic-shell">
    <TopicSidebar lang={lang} active={entry.slug} section={section === "preface" ? "ortho" : section} />
    <article class="topic-article" data-topic-article data-pagefind-body>
      <span class="eyebrow topic-eyebrow">{eyebrow}</span>
      {entry.data.kind === "topic" && entry.data.topicNumber && sectionTopics.length > 1 && (
        <ol class="section-progress" aria-label={`Topic ${entry.data.topicNumber} of ${sectionTopics.length}`}>
          {sectionTopics.map((e) => {
            const isCurrent = e.slug === entry.slug;
            return (
              <li class={`sp-dot${isCurrent ? " is-current" : ""}`}>
                {isCurrent ? (
                  <span class="sp-current" aria-current="true" title={`${e.data.topicNumber}. ${e.data.title}`}></span>
                ) : (
                  <a href={topicPath(lang, e)} class="sp-link" title={`${e.data.topicNumber}. ${e.data.title}`} aria-label={e.data.title}></a>
                )}
              </li>
            );
          })}
        </ol>
      )}
      <h1 class="topic-title">{entry.data.title}</h1>
      <div class="prose" data-topic-prose>
        <slot />
      </div>
      {entry.data.kind === "topic" && entry.data.section && entry.data.topicNumber && (
        <aside class="test-yourself">
          <a
            class="test-yourself-cta"
            href={pathUrl(`/${lang}/${entry.data.section}/${entry.data.topicNumber}/test/`)}
          >
            {t.testYourself}
            <span class="test-yourself-arrow" aria-hidden="true">→</span>
          </a>
        </aside>
      )}
      <nav class="topic-prev-next" aria-label="prev/next">
        {prev ? (
          <a href={topicPath(lang, prev)} class="pn pn-prev" rel="prev">
            <div class="pn-label">{t.prev}</div>
            <div class="pn-title">{prev.data.title}</div>
          </a>
        ) : <span />}
        {next ? (
          <a href={topicPath(lang, next)} class="pn pn-next" rel="next">
            <div class="pn-label">{t.next}</div>
            <div class="pn-title">{next.data.title}</div>
          </a>
        ) : <span />}
      </nav>
    </article>
    <TopicTOC lang={lang} headings={headings} />
  </div>
</BaseLayout>

<script is:inline define:vars={{ toastText }}>
  // ───────────────────────────────────────────────────────────────────
  // Pass-A paywall preview gate.
  //
  // When ?preview=locked is present, transform the page client-side into
  // the locked variant: trim prose to ~300 words at a paragraph boundary,
  // apply the fade mask via .paywall-shell, reveal the overlay card, and
  // gray-out right-TOC anchors that point at sections we've hidden.
  //
  // Pass B will replace this with server-side enforcement via a CF Worker.
  // ───────────────────────────────────────────────────────────────────
  (function () {
    const WORD_TARGET = 300;

    function showToast(msg) {
      let el = document.getElementById("paywall-toast");
      if (!el) {
        el = document.createElement("div");
        el.id = "paywall-toast";
        el.className = "paywall-toast";
        el.setAttribute("role", "status");
        el.setAttribute("aria-live", "polite");
        document.body.appendChild(el);
      }
      el.textContent = msg;
      // Force reflow so the transition runs on each click.
      // eslint-disable-next-line no-unused-expressions
      el.offsetWidth;
      el.classList.add("is-visible");
      clearTimeout(el._t);
      el._t = setTimeout(function () { el.classList.remove("is-visible"); }, 3200);
    }

    function wireStubs() {
      document.querySelectorAll("[data-paywall-plan], [data-paywall-email]").forEach(function (b) {
        b.addEventListener("click", function (ev) {
          ev.preventDefault();
          showToast(toastText);
        });
      });
    }

    function countWords(text) {
      if (!text) return 0;
      const trimmed = text.replace(/\s+/g, " ").trim();
      if (!trimmed) return 0;
      return trimmed.split(" ").length;
    }

    function lockProse(proseEl) {
      // Walk top-level children. Keep elements until cumulative word count
      // reaches WORD_TARGET; remove everything after the boundary element.
      // This guarantees we cut at an element boundary (never mid-word).
      let cumulative = 0;
      let boundary = null;
      const children = Array.from(proseEl.children);
      for (const child of children) {
        cumulative += countWords(child.textContent || "");
        if (cumulative >= WORD_TARGET) {
          boundary = child;
          break;
        }
      }
      if (!boundary) return new Set(); // prose was already shorter than the target
      // Collect H2 slugs that survive the cut so we can mark the rest as locked.
      const visibleSlugs = new Set();
      const visibleNodes = [];
      for (const child of children) {
        visibleNodes.push(child);
        if (child === boundary) break;
      }
      for (const node of visibleNodes) {
        if (node.id) visibleSlugs.add(node.id);
        node.querySelectorAll("[id]").forEach(function (n) { visibleSlugs.add(n.id); });
      }
      // Remove everything after the boundary.
      let n = boundary.nextSibling;
      while (n) {
        const next = n.nextSibling;
        n.parentNode.removeChild(n);
        n = next;
      }
      return visibleSlugs;
    }

    function dimRightTOC(visibleSlugs) {
      document.querySelectorAll(".topic-toc [data-toc-slug]").forEach(function (a) {
        const slug = a.getAttribute("data-toc-slug");
        if (!visibleSlugs.has(slug)) {
          a.classList.add("is-locked");
          // Prevent the anchor from jumping to a missing target.
          a.addEventListener("click", function (ev) { ev.preventDefault(); });
        }
      });
    }

    function applyLock() {
      const article = document.querySelector("[data-topic-article]");
      const prose = document.querySelector("[data-topic-prose]");
      const card = document.querySelector("[data-paywall-card]");
      if (!article || !prose || !card) return;
      const visibleSlugs = lockProse(prose);
      article.classList.add("paywall-shell");
      card.removeAttribute("hidden");
      dimRightTOC(visibleSlugs);
      // Right TOC scroll-spy is initialised separately; mark all links as
      // not-current so the gray-out is the only visual state.
      document.querySelectorAll(".topic-toc-link.is-current").forEach(function (a) {
        a.classList.remove("is-current");
      });
    }

    function init() {
      // Wire the toast handlers regardless — the card may be hidden but the
      // handler attaches harmlessly. They activate when card is revealed.
      wireStubs();

      // Check the query string for the preview flag.
      let isLocked = false;
      try {
        const params = new URLSearchParams(window.location.search);
        isLocked = params.get("preview") === "locked";
      } catch (_) { /* no-op */ }
      if (!isLocked) return;
      applyLock();
    }

    if (document.readyState !== "loading") init();
    else document.addEventListener("DOMContentLoaded", init);
  })();
</script>

<style>
  .topic-shell {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: var(--s-7);
    padding-bottom: var(--s-9);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }
  @media (min-width: 1024px) {
    .topic-shell {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: var(--s-6);
    }
  }
  @media (min-width: 1180px) {
    .topic-shell {
      grid-template-columns: 260px minmax(0, 1fr) 220px;
      gap: var(--s-6);
    }
  }
  .topic-article {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
  }
  /* Section/topic label above title is redundant with the left sidebar
     (section name) and right TOC ("В тази тема") when both rails are visible.
     Hide it on lg+ where the sidebar is showing; keep on smaller screens
     where the sidebar is in the mobile drawer. */
  @media (min-width: 1024px) {
    .topic-eyebrow { display: none; }
  }
  .section-progress {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: flex;
    gap: 3px;
    align-items: stretch;
    width: 100%;
  }
  .sp-dot {
    flex: 1 1 0;
    min-width: 0;
    display: block;
  }
  .sp-link,
  .sp-current {
    display: block;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    transition: background-color 160ms var(--ease), transform 200ms var(--ease);
  }
  .sp-link:hover {
    background: var(--accent);
    transform: scaleY(1.6);
  }
  .sp-current {
    background: var(--accent);
    height: 6px;
    margin-top: -1px;
  }

  .topic-title {
    /* ~1.5× body text (body = 1.0625rem). Calm, not display-size. */
    font-size: 1.625rem;
    font-weight: 650;
    letter-spacing: -0.012em;
    line-height: 1.3;
    margin: 0 0 var(--s-6);
    max-width: 38ch;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .topic-prev-next {
    display: flex;
    gap: var(--s-5);
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    align-items: flex-start;
    justify-content: space-between;
  }
  .pn { display: block; max-width: 22ch; }
  .pn-next { margin-left: auto; text-align: right; }
  .pn-label {
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-muted);
    margin-bottom: var(--s-1);
  }
  .pn-title {
    font-size: var(--fs-body);
    color: var(--ink);
    font-weight: 500;
    transition: color 160ms var(--ease);
  }
  .pn:hover .pn-title { color: var(--accent); }

  .test-yourself {
    margin-top: var(--s-8);
    display: flex;
    justify-content: center;
  }
  .test-yourself-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    background: transparent;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    transition: background 160ms var(--ease), color 160ms var(--ease), transform 220ms var(--ease);
  }
  .test-yourself-cta:hover {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-1px);
  }
  .test-yourself-arrow {
    font-size: 1.1em;
    transition: transform 220ms var(--ease);
  }
  .test-yourself-cta:hover .test-yourself-arrow {
    transform: translateX(3px);
  }
</style>
