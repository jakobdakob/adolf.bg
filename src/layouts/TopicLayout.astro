---
import BaseLayout from "./BaseLayout.astro";
import TopicSidebar from "../components/TopicSidebar.astro";
import MobileDrawer from "../components/MobileDrawer.astro";
import { type Lang, ui } from "../i18n/ui";
import { getTopicsByLang, topicPath, type TopicEntry } from "../lib/topics";

interface Props {
  lang: Lang;
  entry: TopicEntry;
  otherPath: string;
}
const { lang, entry, otherPath } = Astro.props;
const t = ui[lang];

const allEntries = await getTopicsByLang(lang);

const section: "ortho" | "trauma" | "anatomy" | "preface" =
  entry.data.kind === "preface" ? "preface" :
  (entry.data.section as any) ?? "ortho";

// prev/next stay within the current section so end-of-Ortho doesn't jump into
// Trauma. Section switching happens via the top nav.
const sectionTopics = allEntries.filter(
  (e) => e.data.kind === "topic" && e.data.section === section
);
const idx = sectionTopics.findIndex((e) => e.slug === entry.slug);
const prev = idx > 0 ? sectionTopics[idx - 1] : undefined;
const next = idx >= 0 && idx < sectionTopics.length - 1 ? sectionTopics[idx + 1] : undefined;

function sectionLabel(s?: string): string {
  if (s === "ortho") return t.sectionOrtho;
  if (s === "trauma") return t.sectionTrauma;
  if (s === "anatomy") return t.sectionAnatomy;
  return t.preface;
}

const eyebrow =
  entry.data.kind === "preface"
    ? t.preface
    : `${sectionLabel(entry.data.section)} · ${t.topicNumberLabel(entry.data.topicNumber!)}`;
---
<BaseLayout
  lang={lang}
  title={entry.data.title}
  otherPath={otherPath}
  currentSection={section as any}
  showMenuButton={true}
>
  <MobileDrawer lang={lang} active={entry.slug} section={section === "preface" ? "ortho" : section} />
  <div class="topic-shell">
    <TopicSidebar lang={lang} active={entry.slug} section={section === "preface" ? "ortho" : section} />
    <article class="topic-article">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="topic-title">{entry.data.title}</h1>
      <div class="prose">
        <slot />
      </div>
      <nav class="topic-prev-next" aria-label="prev/next">
        {prev ? (
          <a href={topicPath(lang, prev)} class="pn pn-prev">
            <div class="pn-label">{t.prev}</div>
            <div class="pn-title">{prev.data.title}</div>
          </a>
        ) : <span />}
        {next ? (
          <a href={topicPath(lang, next)} class="pn pn-next">
            <div class="pn-label">{t.next}</div>
            <div class="pn-title">{next.data.title}</div>
          </a>
        ) : <span />}
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .topic-shell {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
    padding-top: var(--s-7);
    padding-bottom: var(--s-9);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }
  @media (min-width: 1024px) {
    .topic-shell {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: var(--s-9);
    }
  }
  .topic-article { min-width: 0; }
  .topic-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    letter-spacing: var(--tracking-tighter);
    line-height: 1.05;
    margin: 0 0 var(--s-7);
    max-width: 22ch;
  }
  .topic-prev-next {
    display: flex;
    gap: var(--s-5);
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    align-items: flex-start;
    justify-content: space-between;
  }
  .pn { display: block; max-width: 22ch; }
  .pn-next { margin-left: auto; text-align: right; }
  .pn-label {
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-muted);
    margin-bottom: var(--s-1);
  }
  .pn-title {
    font-size: var(--fs-body);
    color: var(--ink);
    font-weight: 500;
    transition: color 160ms var(--ease);
  }
  .pn:hover .pn-title { color: var(--accent); }
</style>
