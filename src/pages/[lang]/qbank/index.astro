---
import { LANGS, type Lang, ui } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTopicsByLang, groupTopics, topicPath, url as pathUrl } from "../../../lib/topics";

export async function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
const otherPath = pathUrl(`/${lang === "bg" ? "en" : "bg"}/qbank/`);

const all = await getTopicsByLang(lang);
const { ortho, trauma, anatomy } = groupTopics(all);

const mixedCtaTitle = lang === "bg" ? "Смесен тест" : "Mixed quiz";
const mixedCtaMeta  = lang === "bg" ? "20 въпроса · от всички теми" : "20 questions · across all topics";
const mixedCtaStart = lang === "bg" ? "Започни" : "Start";

const gameCtaStart = lang === "bg" ? "Играй" : "Play";

const sectionTitle  = lang === "bg" ? "По раздел" : "By section";
const sectionLede   = lang === "bg"
  ? "Избери раздел и кликни тема за нейните 20 въпроса."
  : "Pick a section and click a topic for its 20-question test.";

const sections = [
  { id: "ortho",   label: t.sectionOrtho,   topics: ortho },
  { id: "trauma",  label: t.sectionTrauma,  topics: trauma },
  { id: "anatomy", label: t.sectionAnatomy, topics: anatomy },
] as const;

function testPath(e: typeof ortho[number]) {
  return pathUrl(`/${lang}/${e.data.section}/${e.data.topicNumber}/test/`);
}
---
<BaseLayout
  lang={lang}
  title={t.qbankIntroTitle}
  description={t.qbankIntroBody}
  otherPath={otherPath}
  currentSection="home"
>
  <section class="qb-hero">
    <span class="eyebrow">{t.qbankIntroTitle}</span>
    <h1 class="qb-title">{mixedCtaTitle}</h1>
    <p class="qb-lede">{mixedCtaMeta}</p>
    <div class="qb-cta-stack">
      <a class="qb-start" href={pathUrl(`/${lang}/qbank/mixed/`)}>{mixedCtaStart} →</a>
      <a class="qb-start qb-start-game" href={pathUrl(`/${lang}/qbank/game/`)}>{gameCtaStart} →</a>
    </div>
  </section>

  <section class="qb-sections">
    <div class="qb-sections-head">
      <span class="eyebrow">{sectionTitle}</span>
      <p class="qb-lede">{sectionLede}</p>
    </div>
    {sections.map((g) => (
      <div class="qb-group">
        <div class="qb-group-label">{g.label} · {g.topics.length}</div>
        <ol class="qb-list">
          {g.topics.map((e) => (
            <li>
              <a href={testPath(e)}>
                <span class="qb-num">{String(e.data.topicNumber).padStart(2, "0")}</span>
                <span class="qb-text">{e.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .qb-hero {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding: var(--s-9) var(--page-pad) var(--s-7);
  }
  .qb-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: var(--s-3) 0 var(--s-3);
  }
  .qb-lede {
    color: var(--ink-muted);
    font-size: 1.0625rem;
    max-width: 60ch;
    margin: 0 0 var(--s-5);
  }
  .qb-cta-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
  }
  .qb-start {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.75rem;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-weight: 600;
    font-size: 1rem;
    transition: background 160ms var(--ease), color 160ms var(--ease), transform 220ms var(--ease);
  }
  .qb-start:hover {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-1px);
  }

  .qb-sections {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding: var(--s-7) var(--page-pad) var(--s-10);
  }
  .qb-sections-head { margin-bottom: var(--s-6); max-width: 60ch; }
  .qb-group { margin-bottom: var(--s-7); }
  .qb-group-label {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s-4);
  }
  .qb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .qb-list { grid-template-columns: 1fr 1fr; column-gap: var(--s-6); }
  }
  @media (min-width: 1100px) {
    .qb-list { grid-template-columns: 1fr 1fr 1fr; column-gap: var(--s-6); }
  }
  .qb-list li { border-bottom: 1px solid var(--rule); }
  .qb-list a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--s-3);
    padding: 0.7rem 0;
    color: var(--ink);
    transition: color 160ms var(--ease), transform 220ms var(--ease);
  }
  .qb-list a:hover { color: var(--accent); transform: translateX(var(--s-2)); }
  .qb-num {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-meta);
    color: var(--ink-faint);
  }
  .qb-list a:hover .qb-num { color: var(--accent); }
  .qb-text { font-size: 0.95rem; line-height: 1.4; }
</style>
